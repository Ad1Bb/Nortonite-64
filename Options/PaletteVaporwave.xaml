<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nortonite 64 · paleta VAPORWAVE (preset Theme Options, options.yaml).
         Nadpisuje role kolorów z Constants.xaml. Wczytywana tylko przez dodatek Theme Options. -->
    <!-- Role: kolory -->
    <Color x:Key="NortniteBackgroundColor">#FF34205E</Color>                  <!-- tło ekranu, paneli, okien, wypełnienie zwykłych przycisków -->
    <Color x:Key="NortniteForegroundColor">#FF05FFA1</Color>                  <!-- etykiety, ramki, linie, nagłówki kolumn poza akcentem, tekst zwykłych przycisków, suwak przewijania -->
    <Color x:Key="NortniteBrightColor">#FFFFFFFF</Color>                      <!-- wartości, nazwy gier na liście, treść komunikatów -->
    <Color x:Key="NortniteAccentColor">#FFFFFB96</Color>                      <!-- tytuły, nagłówki kolumn, etykieta HLTB, wypełnione segmenty pasków, obwódka fokusu -->
    <Color x:Key="NortniteBarColor">#FFFF71CE</Color>                         <!-- belka menu, tytuł aktywnego panelu, zaznaczony wiersz listy, aktywny preset -->
    <Color x:Key="NortniteBarForegroundColor">#FF34205E</Color>               <!-- tekst na tle Bar -->
    <Color x:Key="NortniteDimColor">#FF7457B0</Color>                         <!-- kropki "etykieta …… wartość", puste segmenty pasków, jasne kratki toru przewijania, linie ozdobne -->
    <Color x:Key="NortniteButtonShadowColor">#FF0F8A62</Color>                <!-- twardy cień przycisków -->
    <Color x:Key="NortniteFocusFillColor">#FF05FFA1</Color>                   <!-- tło zaznaczonego przycisku -->
    <Color x:Key="NortniteFocusForegroundColor">#FF34205E</Color>             <!-- tekst zaznaczonego przycisku -->
    <Color x:Key="NortniteCommandBackgroundColor">#FF1E1238</Color>           <!-- tło wiersza poleceń i belki przycisków pada -->
    <Color x:Key="NortniteCommandForegroundColor">#FFB9A7FF</Color>           <!-- tekst wiersza poleceń, kursor -->
    <Color x:Key="NortnitePadBackgroundColor">#FF6B4FA3</Color>               <!-- tło symbolu przycisku pada -->
    <Color x:Key="NortnitePadForegroundColor">#FFFFFFFF</Color>               <!-- symbol przycisku pada -->
    <Color x:Key="NortniteErrorColor">#FFFF6B6B</Color>                       <!-- etykieta [ BŁĄD ] w powiadomieniach -->
    <Color x:Key="NortniteOverlayColor">#99000000</Color>                     <!-- przyciemnienie pod oknami (czarny z kryciem) -->
    <!-- Role: pędzle (kolor wpisany wprost, bo pędzel w zasobach nie śledzi zmiany koloru) -->
    <SolidColorBrush x:Key="NortniteBackgroundBrush" Color="#FF34205E" />
    <SolidColorBrush x:Key="NortniteForegroundBrush" Color="#FF05FFA1" />
    <SolidColorBrush x:Key="NortniteBrightBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NortniteAccentBrush" Color="#FFFFFB96" />
    <SolidColorBrush x:Key="NortniteBarBrush" Color="#FFFF71CE" />
    <SolidColorBrush x:Key="NortniteBarForegroundBrush" Color="#FF34205E" />
    <SolidColorBrush x:Key="NortniteDimBrush" Color="#FF7457B0" />
    <SolidColorBrush x:Key="NortniteButtonShadowBrush" Color="#FF0F8A62" />
    <SolidColorBrush x:Key="NortniteFocusFillBrush" Color="#FF05FFA1" />
    <SolidColorBrush x:Key="NortniteFocusForegroundBrush" Color="#FF34205E" />
    <SolidColorBrush x:Key="NortniteCommandBackgroundBrush" Color="#FF1E1238" />
    <SolidColorBrush x:Key="NortniteCommandForegroundBrush" Color="#FFB9A7FF" />
    <SolidColorBrush x:Key="NortnitePadBackgroundBrush" Color="#FF6B4FA3" />
    <SolidColorBrush x:Key="NortnitePadForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NortniteErrorBrush" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="NortniteOverlayBrush" Color="#99000000" />
    <!-- Klucze motywu domyślnego Playnite przemapowane na role -->
    <Color x:Key="BlackColor">#FF1E1238</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="GlyphColor">#FFFFFB96</Color>
    <Color x:Key="GlyphLightColor">#FFFFFB96</Color>
    <Color x:Key="SelectionLightColor">#FFFF71CE</Color>
    <Color x:Key="OverlayColor">#99000000</Color>
    <Color x:Key="ControlBackgroundColor">#FF34205E</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF34205E</Color>
    <Color x:Key="TextColor">#FF05FFA1</Color>
    <Color x:Key="TextColorDark">#FF7457B0</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FF05FFA1" />
    <SolidColorBrush x:Key="TextBrushDark" Color="#FF7457B0" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FFFFFB96" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FFFFFB96" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF34205E" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FF34205E" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="#FFFF71CE" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FF34205E" />
    <SolidColorBrush x:Key="MainBackgourndBrush" Color="#FF34205E" />
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FFFF71CE" />
    <SolidColorBrush x:Key="BottomBarBackgroundBrush" Color="#FF1E1238" />
    <SolidColorBrush x:Key="OverlayMenuBackgroundBrush" Color="#FF34205E" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFFFFB96" />
    <SolidColorBrush x:Key="GameDetailsBackgroundBrush" Color="#FF34205E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF6B6B" />
</ResourceDictionary>