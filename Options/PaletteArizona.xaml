<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nortonite 64 · paleta ARIZONA (preset Theme Options, options.yaml).
         Nadpisuje role kolorów z Constants.xaml. Wczytywana tylko przez dodatek Theme Options. -->
    <!-- Role: kolory -->
    <Color x:Key="NortniteBackgroundColor">#FF2A1A0F</Color>                  <!-- tło ekranu, paneli, okien, wypełnienie zwykłych przycisków -->
    <Color x:Key="NortniteForegroundColor">#FFD9C4A0</Color>                  <!-- etykiety, ramki, linie, nagłówki kolumn poza akcentem, tekst zwykłych przycisków, suwak przewijania -->
    <Color x:Key="NortniteBrightColor">#FFFFF4E0</Color>                      <!-- wartości, nazwy gier na liście, treść komunikatów -->
    <Color x:Key="NortniteAccentColor">#FF3FB8B0</Color>                      <!-- tytuły, nagłówki kolumn, etykieta HLTB, wypełnione segmenty pasków, obwódka fokusu -->
    <Color x:Key="NortniteBarColor">#FF8E5A36</Color>                         <!-- belka menu, tytuł aktywnego panelu, zaznaczony wiersz listy, aktywny preset -->
    <Color x:Key="NortniteBarForegroundColor">#FFFFF4E0</Color>               <!-- tekst na tle Bar -->
    <Color x:Key="NortniteDimColor">#FF765740</Color>                         <!-- kropki "etykieta …… wartość", puste segmenty pasków, jasne kratki toru przewijania, linie ozdobne -->
    <Color x:Key="NortniteButtonShadowColor">#FF8E5A36</Color>                <!-- twardy cień przycisków -->
    <Color x:Key="NortniteFocusFillColor">#FFD9C4A0</Color>                   <!-- tło zaznaczonego przycisku -->
    <Color x:Key="NortniteFocusForegroundColor">#FF2A1A0F</Color>             <!-- tekst zaznaczonego przycisku -->
    <Color x:Key="NortniteCommandBackgroundColor">#FF170E07</Color>           <!-- tło wiersza poleceń i belki przycisków pada -->
    <Color x:Key="NortniteCommandForegroundColor">#FFD9C4A0</Color>           <!-- tekst wiersza poleceń, kursor -->
    <Color x:Key="NortnitePadBackgroundColor">#FF5C4330</Color>               <!-- tło symbolu przycisku pada -->
    <Color x:Key="NortnitePadForegroundColor">#FFFFF4E0</Color>               <!-- symbol przycisku pada -->
    <Color x:Key="NortniteErrorColor">#FFFF6B5B</Color>                       <!-- etykieta [ BŁĄD ] w powiadomieniach -->
    <Color x:Key="NortniteOverlayColor">#99000000</Color>                     <!-- przyciemnienie pod oknami (czarny z kryciem) -->
    <!-- Role: pędzle (kolor wpisany wprost, bo pędzel w zasobach nie śledzi zmiany koloru) -->
    <SolidColorBrush x:Key="NortniteBackgroundBrush" Color="#FF2A1A0F" />
    <SolidColorBrush x:Key="NortniteForegroundBrush" Color="#FFD9C4A0" />
    <SolidColorBrush x:Key="NortniteBrightBrush" Color="#FFFFF4E0" />
    <SolidColorBrush x:Key="NortniteAccentBrush" Color="#FF3FB8B0" />
    <SolidColorBrush x:Key="NortniteBarBrush" Color="#FF8E5A36" />
    <SolidColorBrush x:Key="NortniteBarForegroundBrush" Color="#FFFFF4E0" />
    <SolidColorBrush x:Key="NortniteDimBrush" Color="#FF765740" />
    <SolidColorBrush x:Key="NortniteButtonShadowBrush" Color="#FF8E5A36" />
    <SolidColorBrush x:Key="NortniteFocusFillBrush" Color="#FFD9C4A0" />
    <SolidColorBrush x:Key="NortniteFocusForegroundBrush" Color="#FF2A1A0F" />
    <SolidColorBrush x:Key="NortniteCommandBackgroundBrush" Color="#FF170E07" />
    <SolidColorBrush x:Key="NortniteCommandForegroundBrush" Color="#FFD9C4A0" />
    <SolidColorBrush x:Key="NortnitePadBackgroundBrush" Color="#FF5C4330" />
    <SolidColorBrush x:Key="NortnitePadForegroundBrush" Color="#FFFFF4E0" />
    <SolidColorBrush x:Key="NortniteErrorBrush" Color="#FFFF6B5B" />
    <SolidColorBrush x:Key="NortniteOverlayBrush" Color="#99000000" />
    <!-- Klucze motywu domyślnego Playnite przemapowane na role -->
    <Color x:Key="BlackColor">#FF170E07</Color>
    <Color x:Key="WhiteColor">#FFFFF4E0</Color>
    <Color x:Key="GlyphColor">#FF3FB8B0</Color>
    <Color x:Key="GlyphLightColor">#FF3FB8B0</Color>
    <Color x:Key="SelectionLightColor">#FF8E5A36</Color>
    <Color x:Key="OverlayColor">#99000000</Color>
    <Color x:Key="ControlBackgroundColor">#FF2A1A0F</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF2A1A0F</Color>
    <Color x:Key="TextColor">#FFD9C4A0</Color>
    <Color x:Key="TextColorDark">#FF765740</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FFD9C4A0" />
    <SolidColorBrush x:Key="TextBrushDark" Color="#FF765740" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF3FB8B0" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FF3FB8B0" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF2A1A0F" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FF2A1A0F" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="#FF8E5A36" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FF2A1A0F" />
    <SolidColorBrush x:Key="MainBackgourndBrush" Color="#FF2A1A0F" />
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FF8E5A36" />
    <SolidColorBrush x:Key="BottomBarBackgroundBrush" Color="#FF170E07" />
    <SolidColorBrush x:Key="OverlayMenuBackgroundBrush" Color="#FF2A1A0F" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF3FB8B0" />
    <SolidColorBrush x:Key="GameDetailsBackgroundBrush" Color="#FF2A1A0F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF6B5B" />
</ResourceDictionary>