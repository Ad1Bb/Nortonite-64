<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nortonite 64 · preset Theme Options: stały (niemigający) kursor w wierszu poleceń.
         Wczytywany tylko przez dodatek Theme Options (options.yaml); domyślne wartości
         tych kluczy są w Constants.xaml. -->
    <Visibility x:Key="NortniteCursorBlinkVisibility">Collapsed</Visibility>
    <Visibility x:Key="NortniteCursorSteadyVisibility">Visible</Visibility>
</ResourceDictionary>
