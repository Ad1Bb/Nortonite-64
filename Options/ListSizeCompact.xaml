<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Nortonite 64 · preset Theme Options: lista gier kompaktowa (więcej wierszy na ekranie).
         Wczytywany tylko przez dodatek Theme Options (options.yaml); wartości domyślne są w Constants.xaml.
         Szerokości kolumn liczą się z fontu (NortniteListCellStyle w Constants.xaml). -->
    <sys:Double x:Key="NortniteListRowHeight">36</sys:Double>
    <sys:Double x:Key="NortniteListFontSize">25.5</sys:Double>
</ResourceDictionary>
