<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nortonite 64 · preset Theme Options: wiersz poleceń zawsze ze ścieżką presetu C:\GRY\<preset>.
         Wczytywany tylko przez dodatek Theme Options (options.yaml); domyślne wartości
         tych kluczy są w Constants.xaml. -->
    <Visibility x:Key="NortniteCmdRealPathVisibility">Collapsed</Visibility>
    <Visibility x:Key="NortniteCmdPresetOnlyVisibility">Visible</Visibility>
</ResourceDictionary>
