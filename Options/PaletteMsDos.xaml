<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nortonite 64 · paleta MS-DOS (preset Theme Options, options.yaml).
         Nadpisuje role kolorów z Constants.xaml. Wczytywana tylko przez dodatek Theme Options. -->
    <!-- Role: kolory -->
    <Color x:Key="NortniteBackgroundColor">#FF000000</Color>                  <!-- tło ekranu, paneli, okien, wypełnienie zwykłych przycisków -->
    <Color x:Key="NortniteForegroundColor">#FFA0A0A0</Color>                  <!-- etykiety, ramki, linie, nagłówki kolumn poza akcentem, tekst zwykłych przycisków, suwak przewijania -->
    <Color x:Key="NortniteBrightColor">#FFF2F2F2</Color>                      <!-- wartości, nazwy gier na liście, treść komunikatów -->
    <Color x:Key="NortniteAccentColor">#FF61B5F0</Color>                      <!-- tytuły, nagłówki kolumn, etykieta HLTB, wypełnione segmenty pasków, obwódka fokusu -->
    <Color x:Key="NortniteBarColor">#FFC0C0C0</Color>                         <!-- belka menu, tytuł aktywnego panelu, zaznaczony wiersz listy, aktywny preset -->
    <Color x:Key="NortniteBarForegroundColor">#FF000000</Color>               <!-- tekst na tle Bar -->
    <Color x:Key="NortniteDimColor">#FF555555</Color>                         <!-- kropki "etykieta …… wartość", puste segmenty pasków, jasne kratki toru przewijania, linie ozdobne -->
    <Color x:Key="NortniteButtonShadowColor">#FF666666</Color>                <!-- twardy cień przycisków -->
    <Color x:Key="NortniteFocusFillColor">#FFF2F2F2</Color>                   <!-- tło zaznaczonego przycisku -->
    <Color x:Key="NortniteFocusForegroundColor">#FF000000</Color>             <!-- tekst zaznaczonego przycisku -->
    <Color x:Key="NortniteCommandBackgroundColor">#FF000000</Color>           <!-- tło wiersza poleceń i belki przycisków pada -->
    <Color x:Key="NortniteCommandForegroundColor">#FFC0C0C0</Color>           <!-- tekst wiersza poleceń, kursor -->
    <Color x:Key="NortnitePadBackgroundColor">#FF3A3A3A</Color>               <!-- tło symbolu przycisku pada -->
    <Color x:Key="NortnitePadForegroundColor">#FFF2F2F2</Color>               <!-- symbol przycisku pada -->
    <Color x:Key="NortniteErrorColor">#FFE74856</Color>                       <!-- etykieta [ BŁĄD ] w powiadomieniach -->
    <Color x:Key="NortniteOverlayColor">#B3000000</Color>                     <!-- przyciemnienie pod oknami (czarny z kryciem) -->
    <!-- Role: pędzle (kolor wpisany wprost, bo pędzel w zasobach nie śledzi zmiany koloru) -->
    <SolidColorBrush x:Key="NortniteBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NortniteForegroundBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="NortniteBrightBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="NortniteAccentBrush" Color="#FF61B5F0" />
    <SolidColorBrush x:Key="NortniteBarBrush" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="NortniteBarForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NortniteDimBrush" Color="#FF555555" />
    <SolidColorBrush x:Key="NortniteButtonShadowBrush" Color="#FF666666" />
    <SolidColorBrush x:Key="NortniteFocusFillBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="NortniteFocusForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NortniteCommandBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NortniteCommandForegroundBrush" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="NortnitePadBackgroundBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="NortnitePadForegroundBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="NortniteErrorBrush" Color="#FFE74856" />
    <SolidColorBrush x:Key="NortniteOverlayBrush" Color="#B3000000" />
    <!-- Klucze motywu domyślnego Playnite przemapowane na role -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFF2F2F2</Color>
    <Color x:Key="GlyphColor">#FF61B5F0</Color>
    <Color x:Key="GlyphLightColor">#FF61B5F0</Color>
    <Color x:Key="SelectionLightColor">#FFC0C0C0</Color>
    <Color x:Key="OverlayColor">#B3000000</Color>
    <Color x:Key="ControlBackgroundColor">#FF000000</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF000000</Color>
    <Color x:Key="TextColor">#FFA0A0A0</Color>
    <Color x:Key="TextColorDark">#FF555555</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="TextBrushDark" Color="#FF555555" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF61B5F0" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FF61B5F0" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="MainBackgourndBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="BottomBarBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="OverlayMenuBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF61B5F0" />
    <SolidColorBrush x:Key="GameDetailsBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFE74856" />
</ResourceDictionary>