<?xml version="1.0" encoding="utf-8"?>
<!-- Nortonite 64: theme strings, Czech. Keys missing here fall back to en_US.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Decorative path: <DriveRoot><PRESET NAME>> start <game> -->
    <sys:String x:Key="LOCNortniteDriveRoot">C:\HRY\</sys:String>
    <sys:String x:Key="LOCNortniteFilesCount" xml:space="preserve"> soubor(ů)</sys:String>
    <sys:String x:Key="LOCNortniteSelectHint">výběr</sys:String>

    <!-- Main view -->
    <sys:String x:Key="LOCNortniteMenu">Menu</sys:String>
    <sys:String x:Key="LOCNortniteUpdate">Aktualizace</sys:String>
    <sys:String x:Key="LOCNortniteInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteColumnLibrary">Knihovna</sys:String>
    <sys:String x:Key="LOCNortniteColumnPlatform">Platforma</sys:String>
    <sys:String x:Key="LOCNortniteColumnGenre">Žánr</sys:String>
    <sys:String x:Key="LOCNortniteColumnDeveloper">Studio</sys:String>
    <sys:String x:Key="LOCNortniteColumnYear">Rok</sys:String>
    <sys:String x:Key="LOCNortniteColumnAdded">Přidáno</sys:String>
    <sys:String x:Key="LOCNortniteColumnLastPlayed">Hráno</sys:String>
    <sys:String x:Key="LOCNortniteColumnStatus">Stav</sys:String>
    <sys:String x:Key="LOCNortniteColumnTime">Čas</sys:String>
    <sys:String x:Key="LOCNortniteScores">Komunita / kritici</sys:String>
    <sys:String x:Key="LOCNortnitePreset">Předvolba</sys:String>
    <!-- Buttons under the game info and their pad hints. Keep them SHORT: the button row
         is 666 px wide and must fit on one line in every language, also with "Install"
         (about 22 Latin characters for the longer of Play/Install + Details + Options). -->
    <sys:String x:Key="LOCNortniteButtonPlay">Hrát</sys:String>
    <sys:String x:Key="LOCNortniteButtonInstall">Instalovat</sys:String>
    <sys:String x:Key="LOCNortniteButtonDetails">Detaily</sys:String>
    <sys:String x:Key="LOCNortniteButtonOptions">Volby</sys:String>

    <!-- HowLongToBeat -->
    <sys:String x:Key="LOCNortniteHltbShort">HLTB</sys:String>
    <sys:String x:Key="LOCNortniteHltbLong">HowLongToBeat</sys:String>
    <sys:String x:Key="LOCNortniteHltbMain">Příběh</sys:String>
    <sys:String x:Key="LOCNortniteHltbMainLong">Hlavní příběh</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtra">+ extra</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtraLong">Příběh + extra</sys:String>
    <sys:String x:Key="LOCNortniteHltbCompletionist">100%</sys:String>
    <!-- Pasek oceny zamiast HowLongToBeat: krótka etykieta w panelu INFO, długa w szczegółach i opcjach -->
    <sys:String x:Key="LOCNortniteScoreCommunity">Hráči</sys:String>
    <sys:String x:Key="LOCNortniteScoreCritic">Kritici</sys:String>
    <sys:String x:Key="LOCNortniteScoreCommunityLong">Hodnocení hráčů</sys:String>
    <sys:String x:Key="LOCNortniteScoreCriticLong">Hodnocení kritiků</sys:String>

    <!-- Game details, game menu, launch screen -->
    <sys:String x:Key="LOCNortniteGameDetailsTitle">PODROBNOSTI HRY</sys:String>
    <sys:String x:Key="LOCNortniteGameMenuTitle">MENU HRY</sys:String>
    <sys:String x:Key="LOCNortniteMainMenuTitle">Hlavní menu</sys:String>
    <sys:String x:Key="LOCNortniteLaunchingTitle">SPOUŠTĚNÍ</sys:String>
    <sys:String x:Key="LOCNortniteLoadingProgram">Načítání programu…</sys:String>
    <sys:String x:Key="LOCNortniteConventionalMemory">Konvenční paměť</sys:String>
    <sys:String x:Key="LOCNortniteDrivers">Ovladače</sys:String>
    <sys:String x:Key="LOCNortniteStatusOk">OK</sys:String>
    <sys:String x:Key="LOCNortniteNavigate">Navigace</sys:String>
    <sys:String x:Key="LOCNortniteCloseHint">zavřít</sys:String>
    <sys:String x:Key="LOCNortniteFiltersTitle">FILTRY</sys:String>
    <sys:String x:Key="LOCNortniteAdditionalFiltersTitle">DALŠÍ FILTRY</sys:String>
    <sys:String x:Key="LOCNortniteNotificationInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteNotificationError">CHYBA</sys:String>
    <sys:String x:Key="LOCNortniteSettingsTitle">NASTAVENÍ</sys:String>
    <!-- Theme options (Theme Options extension, options.yaml) -->
    <sys:String x:Key="LOCNortniteOptPalette">Barevná paleta</sys:String>
    <sys:String x:Key="LOCNortnitePaletteNorton">NORTON</sys:String>
    <sys:String x:Key="LOCNortnitePaletteBios">BIOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteMsDos">MS-DOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSynthwave">SYNTHWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteOutrun">OUTRUN</sys:String>
    <sys:String x:Key="LOCNortnitePaletteVaporwave">VAPORWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSunset">SUNSET</sys:String>
    <sys:String x:Key="LOCNortnitePaletteArizona">ARIZONA</sys:String>
    <sys:String x:Key="LOCNortniteOptListSize">Velikost seznamu her</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeCompact">Kompaktní</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeNormal">Normální</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeLarge">Velký</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn">Druhý sloupec seznamu</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn3">Třetí sloupec seznamu</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTarget">Ukazatel HowLongToBeat měří</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetMain">Hlavní příběh</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetExtra">Příběh + extra</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetCompletionist">Dohrání na 100%</sys:String>
    <sys:String x:Key="LOCNortniteOptInfoBar">Lišta pod údaji o hře</sys:String>
    <sys:String x:Key="LOCNortniteOptLaunchScreen">Obrazovka spouštění hry</sys:String>
    <sys:String x:Key="LOCNortniteOptShow">Zobrazit</sys:String>
    <sys:String x:Key="LOCNortniteOptHide">Skrýt</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPath">Cesta v příkazovém řádku</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathInstall">Instalační složka hry</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathPreset">Cesta předvolby</sys:String>
    <sys:String x:Key="LOCNortniteOptCursor">Kurzor příkazového řádku</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorBlinking">Blikající</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorSteady">Stálý</sys:String>
    <!-- C:\>MEM panel under the cover -->
    <sys:String x:Key="LOCNortniteMemInstalled">[■] Nainstalováno</sys:String>
    <sys:String x:Key="LOCNortniteMemNotInstalled">[ ] Nenainstalováno</sys:String>
    <sys:String x:Key="LOCNortniteMemSize">Velikost</sys:String>
    <sys:String x:Key="LOCNortniteMemSizeError">CHYBA</sys:String>
    <sys:String x:Key="LOCNortniteMemReleased">Vydáno</sys:String>
    <!-- Size with one decimal place: the number is in tenths of the unit,
         ',' is this language's decimal separator (e.g. 337 → 33,7) -->
    <sys:String x:Key="LOCNortniteSizeGbFormat">{0:0&apos;,&apos;0} GB</sys:String>
    <sys:String x:Key="LOCNortniteSizeMbFormat">{0:0&apos;,&apos;0} MB</sys:String>
    <!-- Play time, compact (game list column is 120 px): {0} = hours, {1} = minutes.
         Keep it as short as "999h 59m"; under one hour only minutes are shown. -->
    <sys:String x:Key="LOCNortniteTimeHoursFormat">{0}h {1}m</sys:String>
    <sys:String x:Key="LOCNortniteTimeMinutesFormat">{0}m</sys:String>
</ResourceDictionary>
