<?xml version="1.0" encoding="utf-8"?>
<!-- Nortonite 64: theme strings, Chinese (Simplified). Keys missing here fall back to en_US.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Decorative path: <DriveRoot><PRESET NAME>> start <game> -->
    <sys:String x:Key="LOCNortniteDriveRoot">C:\GAMES\</sys:String>
    <sys:String x:Key="LOCNortniteFilesCount" xml:space="preserve"> 个文件</sys:String>
    <sys:String x:Key="LOCNortniteSelectHint">选择</sys:String>

    <!-- Main view -->
    <sys:String x:Key="LOCNortniteMenu">菜单</sys:String>
    <sys:String x:Key="LOCNortniteUpdate">更新</sys:String>
    <sys:String x:Key="LOCNortniteInfo">信息</sys:String>
    <sys:String x:Key="LOCNortniteColumnTime">时长</sys:String>
    <sys:String x:Key="LOCNortniteScores">玩家 / 媒体评分</sys:String>
    <sys:String x:Key="LOCNortnitePreset">预设</sys:String>
    <!-- Buttons under the game info and their pad hints. Keep them SHORT: the button row
         is 666 px wide and must fit on one line in every language, also with "Install"
         (about 22 Latin characters for the longer of Play/Install + Details + Options). -->
    <sys:String x:Key="LOCNortniteButtonPlay">游玩</sys:String>
    <sys:String x:Key="LOCNortniteButtonInstall">安装</sys:String>
    <sys:String x:Key="LOCNortniteButtonDetails">详情</sys:String>
    <sys:String x:Key="LOCNortniteButtonOptions">选项</sys:String>

    <!-- HowLongToBeat -->
    <sys:String x:Key="LOCNortniteHltbShort">HLTB</sys:String>
    <sys:String x:Key="LOCNortniteHltbLong">HowLongToBeat</sys:String>
    <sys:String x:Key="LOCNortniteHltbMain">主线</sys:String>
    <sys:String x:Key="LOCNortniteHltbMainLong">主线剧情</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtra">+ 支线</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtraLong">主线 + 支线</sys:String>
    <sys:String x:Key="LOCNortniteHltbCompletionist">100%</sys:String>
    <!-- Pasek oceny zamiast HowLongToBeat: krótka etykieta w panelu INFO, długa w szczegółach i opcjach -->
    <sys:String x:Key="LOCNortniteScoreCommunity">玩家</sys:String>
    <sys:String x:Key="LOCNortniteScoreCritic">媒体</sys:String>
    <sys:String x:Key="LOCNortniteScoreCommunityLong">玩家评分</sys:String>
    <sys:String x:Key="LOCNortniteScoreCriticLong">媒体评分</sys:String>

    <!-- Game details, game menu, launch screen -->
    <sys:String x:Key="LOCNortniteGameDetailsTitle">游戏详情</sys:String>
    <sys:String x:Key="LOCNortniteGameMenuTitle">游戏菜单</sys:String>
    <sys:String x:Key="LOCNortniteMainMenuTitle">主菜单</sys:String>
    <sys:String x:Key="LOCNortniteLaunchingTitle">正在启动</sys:String>
    <sys:String x:Key="LOCNortniteLoadingProgram">正在加载程序…</sys:String>
    <sys:String x:Key="LOCNortniteConventionalMemory">常规内存</sys:String>
    <sys:String x:Key="LOCNortniteDrivers">驱动程序</sys:String>
    <sys:String x:Key="LOCNortniteStatusOk">OK</sys:String>
    <sys:String x:Key="LOCNortniteNavigate">导航</sys:String>
    <sys:String x:Key="LOCNortniteCloseHint">关闭</sys:String>
    <sys:String x:Key="LOCNortniteFiltersTitle">筛选</sys:String>
    <sys:String x:Key="LOCNortniteAdditionalFiltersTitle">更多筛选</sys:String>
    <sys:String x:Key="LOCNortniteNotificationInfo">信息</sys:String>
    <sys:String x:Key="LOCNortniteNotificationError">错误</sys:String>
    <sys:String x:Key="LOCNortniteSettingsTitle">设置</sys:String>
    <!-- Theme options (Theme Options extension, options.yaml) -->
    <sys:String x:Key="LOCNortniteOptPalette">配色方案</sys:String>
    <sys:String x:Key="LOCNortnitePaletteNorton">NORTON</sys:String>
    <sys:String x:Key="LOCNortnitePaletteBios">BIOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteMsDos">MS-DOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSynthwave">SYNTHWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteOutrun">OUTRUN</sys:String>
    <sys:String x:Key="LOCNortnitePaletteVaporwave">VAPORWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSunset">SUNSET</sys:String>
    <sys:String x:Key="LOCNortnitePaletteArizona">ARIZONA</sys:String>
    <sys:String x:Key="LOCNortniteOptListSize">游戏列表大小</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeCompact">紧凑</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeNormal">标准</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeLarge">大</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn">列表第二列</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTarget">HowLongToBeat 进度条衡量</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetMain">主线剧情</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetExtra">主线 + 支线</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetCompletionist">完美通关</sys:String>
    <sys:String x:Key="LOCNortniteOptInfoBar">游戏信息下方的条</sys:String>
    <sys:String x:Key="LOCNortniteOptLaunchScreen">游戏启动画面</sys:String>
    <sys:String x:Key="LOCNortniteOptShow">显示</sys:String>
    <sys:String x:Key="LOCNortniteOptHide">隐藏</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPath">命令行路径</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathInstall">游戏安装文件夹</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathPreset">预设路径</sys:String>
    <sys:String x:Key="LOCNortniteOptCursor">命令行光标</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorBlinking">闪烁</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorSteady">常亮</sys:String>
    <!-- C:\>MEM panel under the cover -->
    <sys:String x:Key="LOCNortniteMemInstalled">[■] 已安装</sys:String>
    <sys:String x:Key="LOCNortniteMemNotInstalled">[ ] 未安装</sys:String>
    <sys:String x:Key="LOCNortniteMemSize">大小</sys:String>
    <sys:String x:Key="LOCNortniteMemSizeError">错误</sys:String>
    <sys:String x:Key="LOCNortniteMemReleased">发行</sys:String>
    <!-- Size with one decimal place: the number is in tenths of the unit,
         '.' is this language's decimal separator (e.g. 337 → 33.7 GB) -->
    <sys:String x:Key="LOCNortniteSizeGbFormat">{0:0&apos;.&apos;0} GB</sys:String>
    <sys:String x:Key="LOCNortniteSizeMbFormat">{0:0&apos;.&apos;0} MB</sys:String>
    <!-- Play time, compact (game list column is 120 px): {0} = hours, {1} = minutes.
         Keep it as short as "999h 59m"; under one hour only minutes are shown. -->
    <sys:String x:Key="LOCNortniteTimeHoursFormat">{0}h {1}m</sys:String>
    <sys:String x:Key="LOCNortniteTimeMinutesFormat">{0}m</sys:String>
</ResourceDictionary>
