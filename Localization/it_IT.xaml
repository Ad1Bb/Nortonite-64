<?xml version="1.0" encoding="utf-8"?>
<!-- Nortonite 64: theme strings, Italian. Keys missing here fall back to en_US.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Decorative path: <DriveRoot><PRESET NAME>> start <game> -->
    <sys:String x:Key="LOCNortniteDriveRoot">C:\GIOCHI\</sys:String>
    <sys:String x:Key="LOCNortniteFilesCount" xml:space="preserve"> file</sys:String>
    <sys:String x:Key="LOCNortniteSelectHint">seleziona</sys:String>

    <!-- Main view -->
    <sys:String x:Key="LOCNortniteMenu">Menu</sys:String>
    <sys:String x:Key="LOCNortniteUpdate">Aggiornamento</sys:String>
    <sys:String x:Key="LOCNortniteInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteColumnLibrary">Libreria</sys:String>
    <sys:String x:Key="LOCNortniteColumnPlatform">Piattaforma</sys:String>
    <sys:String x:Key="LOCNortniteColumnGenre">Genere</sys:String>
    <sys:String x:Key="LOCNortniteColumnDeveloper">Studio</sys:String>
    <sys:String x:Key="LOCNortniteColumnYear">Anno</sys:String>
    <sys:String x:Key="LOCNortniteColumnAdded">Aggiunto</sys:String>
    <sys:String x:Key="LOCNortniteColumnLastPlayed">Giocato</sys:String>
    <sys:String x:Key="LOCNortniteColumnStatus">Stato</sys:String>
    <sys:String x:Key="LOCNortniteColumnTime">Tempo</sys:String>
    <sys:String x:Key="LOCNortniteScores">Community / critica</sys:String>
    <sys:String x:Key="LOCNortnitePreset">Preset</sys:String>
    <!-- Buttons under the game info and their pad hints. Keep them SHORT: the button row
         is 666 px wide and must fit on one line in every language, also with "Install"
         (about 22 Latin characters for the longer of Play/Install + Details + Options). -->
    <sys:String x:Key="LOCNortniteButtonPlay">Gioca</sys:String>
    <sys:String x:Key="LOCNortniteButtonInstall">Installa</sys:String>
    <sys:String x:Key="LOCNortniteButtonDetails">Info</sys:String>
    <sys:String x:Key="LOCNortniteButtonOptions">Opzioni</sys:String>

    <!-- HowLongToBeat -->
    <sys:String x:Key="LOCNortniteHltbShort">HLTB</sys:String>
    <sys:String x:Key="LOCNortniteHltbLong">HowLongToBeat</sys:String>
    <sys:String x:Key="LOCNortniteHltbMain">Storia</sys:String>
    <sys:String x:Key="LOCNortniteHltbMainLong">Storia principale</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtra">+ extra</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtraLong">Storia + extra</sys:String>
    <sys:String x:Key="LOCNortniteHltbCompletionist">100%</sys:String>
    <!-- Pasek oceny zamiast HowLongToBeat: krótka etykieta w panelu INFO, długa w szczegółach i opcjach -->
    <sys:String x:Key="LOCNortniteScoreCommunity">Giocatori</sys:String>
    <sys:String x:Key="LOCNortniteScoreCritic">Critica</sys:String>
    <sys:String x:Key="LOCNortniteScoreCommunityLong">Voto dei giocatori</sys:String>
    <sys:String x:Key="LOCNortniteScoreCriticLong">Voto della critica</sys:String>

    <!-- Game details, game menu, launch screen -->
    <sys:String x:Key="LOCNortniteGameDetailsTitle">DETTAGLI GIOCO</sys:String>
    <sys:String x:Key="LOCNortniteGameMenuTitle">MENU GIOCO</sys:String>
    <sys:String x:Key="LOCNortniteMainMenuTitle">Menu principale</sys:String>
    <sys:String x:Key="LOCNortniteLaunchingTitle">AVVIO</sys:String>
    <sys:String x:Key="LOCNortniteLoadingProgram">Caricamento programma…</sys:String>
    <sys:String x:Key="LOCNortniteConventionalMemory">Memoria convenzionale</sys:String>
    <sys:String x:Key="LOCNortniteDrivers">Driver</sys:String>
    <sys:String x:Key="LOCNortniteStatusOk">OK</sys:String>
    <sys:String x:Key="LOCNortniteNavigate">Naviga</sys:String>
    <sys:String x:Key="LOCNortniteCloseHint">chiudi</sys:String>
    <sys:String x:Key="LOCNortniteFiltersTitle">FILTRI</sys:String>
    <sys:String x:Key="LOCNortniteAdditionalFiltersTitle">ALTRI FILTRI</sys:String>
    <sys:String x:Key="LOCNortniteNotificationInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteNotificationError">ERRORE</sys:String>
    <sys:String x:Key="LOCNortniteSettingsTitle">IMPOSTAZIONI</sys:String>
    <!-- Theme options (Theme Options extension, options.yaml) -->
    <sys:String x:Key="LOCNortniteOptPalette">Tavolozza colori</sys:String>
    <sys:String x:Key="LOCNortnitePaletteNorton">NORTON</sys:String>
    <sys:String x:Key="LOCNortnitePaletteBios">BIOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteMsDos">MS-DOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSynthwave">SYNTHWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteOutrun">OUTRUN</sys:String>
    <sys:String x:Key="LOCNortnitePaletteVaporwave">VAPORWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSunset">SUNSET</sys:String>
    <sys:String x:Key="LOCNortnitePaletteArizona">ARIZONA</sys:String>
    <sys:String x:Key="LOCNortniteOptListSize">Dimensione elenco giochi</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeCompact">Compatta</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeNormal">Normale</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeLarge">Grande</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn">Seconda colonna dell&apos;elenco</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn3">Terza colonna dell&apos;elenco</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTarget">La barra HowLongToBeat misura</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetMain">Storia principale</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetExtra">Storia + extra</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetCompletionist">Completista</sys:String>
    <sys:String x:Key="LOCNortniteOptInfoBar">Barra sotto i dati del gioco</sys:String>
    <sys:String x:Key="LOCNortniteOptLaunchScreen">Schermata di avvio del gioco</sys:String>
    <sys:String x:Key="LOCNortniteOptShow">Mostra</sys:String>
    <sys:String x:Key="LOCNortniteOptHide">Nascondi</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPath">Percorso nella riga di comando</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathInstall">Cartella di installazione del gioco</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathPreset">Percorso del preset</sys:String>
    <sys:String x:Key="LOCNortniteOptCursor">Cursore della riga di comando</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorBlinking">Lampeggiante</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorSteady">Fisso</sys:String>
    <!-- C:\>MEM panel under the cover -->
    <sys:String x:Key="LOCNortniteMemInstalled">[■] Installato</sys:String>
    <sys:String x:Key="LOCNortniteMemNotInstalled">[ ] Non installato</sys:String>
    <sys:String x:Key="LOCNortniteMemSize">Dimensione</sys:String>
    <sys:String x:Key="LOCNortniteMemSizeError">ERRORE</sys:String>
    <sys:String x:Key="LOCNortniteMemReleased">Uscita</sys:String>
    <!-- Size with one decimal place: the number is in tenths of the unit,
         ',' is this language's decimal separator (e.g. 337 → 33,7) -->
    <sys:String x:Key="LOCNortniteSizeGbFormat">{0:0&apos;,&apos;0} GB</sys:String>
    <sys:String x:Key="LOCNortniteSizeMbFormat">{0:0&apos;,&apos;0} MB</sys:String>
    <!-- Play time, compact (game list column is 120 px): {0} = hours, {1} = minutes.
         Keep it as short as "999h 59m"; under one hour only minutes are shown. -->
    <sys:String x:Key="LOCNortniteTimeHoursFormat">{0}h {1}m</sys:String>
    <sys:String x:Key="LOCNortniteTimeMinutesFormat">{0}m</sys:String>
</ResourceDictionary>
