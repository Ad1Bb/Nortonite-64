<?xml version="1.0" encoding="utf-8"?>
<!-- Nortonite 64: theme strings, English (base file, always loaded first). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Decorative path: <DriveRoot><PRESET NAME>> start <game> -->
    <sys:String x:Key="LOCNortniteDriveRoot">C:\GAMES\</sys:String>
    <sys:String x:Key="LOCNortniteFilesCount" xml:space="preserve"> file(s)</sys:String>
    <sys:String x:Key="LOCNortniteSelectHint">select</sys:String>

    <!-- Main view -->
    <sys:String x:Key="LOCNortniteMenu">Menu</sys:String>
    <sys:String x:Key="LOCNortniteUpdate">Update</sys:String>
    <sys:String x:Key="LOCNortniteInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteColumnLibrary">Library</sys:String>
    <sys:String x:Key="LOCNortniteColumnPlatform">Platform</sys:String>
    <sys:String x:Key="LOCNortniteColumnGenre">Genre</sys:String>
    <sys:String x:Key="LOCNortniteColumnDeveloper">Developer</sys:String>
    <sys:String x:Key="LOCNortniteColumnYear">Year</sys:String>
    <sys:String x:Key="LOCNortniteColumnAdded">Added</sys:String>
    <sys:String x:Key="LOCNortniteColumnLastPlayed">Last played</sys:String>
    <sys:String x:Key="LOCNortniteColumnStatus">Status</sys:String>
    <sys:String x:Key="LOCNortniteColumnTime">Time</sys:String>
    <sys:String x:Key="LOCNortniteScores">Community / critics</sys:String>
    <sys:String x:Key="LOCNortnitePreset">Preset</sys:String>
    <!-- Buttons under the game info and their pad hints. Keep them SHORT: the button row
         is 666 px wide and must fit on one line in every language, also with "Install"
         (about 22 Latin characters for the longer of Play/Install + Details + Options). -->
    <sys:String x:Key="LOCNortniteButtonPlay">Play</sys:String>
    <sys:String x:Key="LOCNortniteButtonInstall">Install</sys:String>
    <sys:String x:Key="LOCNortniteButtonDetails">Details</sys:String>
    <sys:String x:Key="LOCNortniteButtonOptions">Options</sys:String>

    <!-- HowLongToBeat -->
    <sys:String x:Key="LOCNortniteHltbShort">HLTB</sys:String>
    <sys:String x:Key="LOCNortniteHltbLong">HowLongToBeat</sys:String>
    <sys:String x:Key="LOCNortniteHltbMain">Main</sys:String>
    <sys:String x:Key="LOCNortniteHltbMainLong">Main story</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtra">+ extras</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtraLong">Main + extras</sys:String>
    <sys:String x:Key="LOCNortniteHltbCompletionist">100%</sys:String>
    <!-- Pasek oceny zamiast HowLongToBeat: krótka etykieta w panelu INFO, długa w szczegółach i opcjach -->
    <sys:String x:Key="LOCNortniteScoreCommunity">Players</sys:String>
    <sys:String x:Key="LOCNortniteScoreCritic">Critics</sys:String>
    <sys:String x:Key="LOCNortniteScoreCommunityLong">Player score</sys:String>
    <sys:String x:Key="LOCNortniteScoreCriticLong">Critic score</sys:String>

    <!-- Game details, game menu, launch screen -->
    <sys:String x:Key="LOCNortniteGameDetailsTitle">GAME DETAILS</sys:String>
    <sys:String x:Key="LOCNortniteGameMenuTitle">GAME MENU</sys:String>
    <sys:String x:Key="LOCNortniteMainMenuTitle">Main menu</sys:String>
    <sys:String x:Key="LOCNortniteLaunchingTitle">LAUNCHING</sys:String>
    <sys:String x:Key="LOCNortniteLoadingProgram">Loading program…</sys:String>
    <sys:String x:Key="LOCNortniteConventionalMemory">Conventional memory</sys:String>
    <sys:String x:Key="LOCNortniteDrivers">Drivers</sys:String>
    <sys:String x:Key="LOCNortniteStatusOk">OK</sys:String>
    <sys:String x:Key="LOCNortniteNavigate">Navigate</sys:String>
    <sys:String x:Key="LOCNortniteCloseHint">close</sys:String>
    <sys:String x:Key="LOCNortniteFiltersTitle">FILTERS</sys:String>
    <sys:String x:Key="LOCNortniteAdditionalFiltersTitle">MORE FILTERS</sys:String>
    <sys:String x:Key="LOCNortniteNotificationInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteNotificationError">ERROR</sys:String>
    <sys:String x:Key="LOCNortniteSettingsTitle">SETTINGS</sys:String>
    <!-- Theme options (Theme Options extension, options.yaml) -->
    <sys:String x:Key="LOCNortniteOptPalette">Color palette</sys:String>
    <sys:String x:Key="LOCNortnitePaletteNorton">NORTON</sys:String>
    <sys:String x:Key="LOCNortnitePaletteBios">BIOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteMsDos">MS-DOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSynthwave">SYNTHWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteOutrun">OUTRUN</sys:String>
    <sys:String x:Key="LOCNortnitePaletteVaporwave">VAPORWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSunset">SUNSET</sys:String>
    <sys:String x:Key="LOCNortnitePaletteArizona">ARIZONA</sys:String>
    <sys:String x:Key="LOCNortniteOptListSize">Game list size</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeCompact">Compact</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeNormal">Normal</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeLarge">Large</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn">Second list column</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn3">Third list column</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTarget">HowLongToBeat bar measures</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetMain">Main story</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetExtra">Main + extras</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetCompletionist">Completionist</sys:String>
    <sys:String x:Key="LOCNortniteOptInfoBar">Bar below game info</sys:String>
    <sys:String x:Key="LOCNortniteOptLaunchScreen">Game launch screen</sys:String>
    <sys:String x:Key="LOCNortniteOptShow">Show</sys:String>
    <sys:String x:Key="LOCNortniteOptHide">Hide</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPath">Command line path</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathInstall">Game install folder</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathPreset">Preset path</sys:String>
    <sys:String x:Key="LOCNortniteOptCursor">Command line cursor</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorBlinking">Blinking</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorSteady">Steady</sys:String>
    <!-- C:\>MEM panel under the cover -->
    <sys:String x:Key="LOCNortniteMemInstalled">[■] Installed</sys:String>
    <sys:String x:Key="LOCNortniteMemNotInstalled">[ ] Not installed</sys:String>
    <sys:String x:Key="LOCNortniteMemSize">Size</sys:String>
    <sys:String x:Key="LOCNortniteMemSizeError">ERROR</sys:String>
    <sys:String x:Key="LOCNortniteMemReleased">Released</sys:String>
    <!-- Size with one decimal place: the number is in tenths of the unit,
         '.' is this language's decimal separator (e.g. 337 → 33.7 GB) -->
    <sys:String x:Key="LOCNortniteSizeGbFormat">{0:0'.'0} GB</sys:String>
    <sys:String x:Key="LOCNortniteSizeMbFormat">{0:0'.'0} MB</sys:String>
    <!-- Play time, compact (game list column is 120 px): {0} = hours, {1} = minutes.
         Keep it as short as "999h 59m"; under one hour only minutes are shown. -->
    <sys:String x:Key="LOCNortniteTimeHoursFormat">{0}h {1}m</sys:String>
    <sys:String x:Key="LOCNortniteTimeMinutesFormat">{0}m</sys:String>
</ResourceDictionary>
