<?xml version="1.0" encoding="utf-8"?>
<!-- Nortonite 64: theme strings, Ukrainian. Keys missing here fall back to en_US.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Decorative path: <DriveRoot><PRESET NAME>> start <game> -->
    <sys:String x:Key="LOCNortniteDriveRoot">C:\GAMES\</sys:String>
    <sys:String x:Key="LOCNortniteFilesCount" xml:space="preserve"> файл(ів)</sys:String>
    <sys:String x:Key="LOCNortniteSelectHint">вибір</sys:String>

    <!-- Main view -->
    <sys:String x:Key="LOCNortniteMenu">Меню</sys:String>
    <sys:String x:Key="LOCNortniteUpdate">Оновлення</sys:String>
    <sys:String x:Key="LOCNortniteInfo">ІНФО</sys:String>
    <sys:String x:Key="LOCNortniteColumnTime">Час</sys:String>
    <sys:String x:Key="LOCNortniteScores">Гравці / критики</sys:String>
    <sys:String x:Key="LOCNortnitePreset">Пресет</sys:String>
    <!-- Buttons under the game info and their pad hints. Keep them SHORT: the button row
         is 666 px wide and must fit on one line in every language, also with "Install"
         (about 22 Latin characters for the longer of Play/Install + Details + Options). -->
    <sys:String x:Key="LOCNortniteButtonPlay">Грати</sys:String>
    <sys:String x:Key="LOCNortniteButtonInstall">Встановити</sys:String>
    <sys:String x:Key="LOCNortniteButtonDetails">Інфо</sys:String>
    <sys:String x:Key="LOCNortniteButtonOptions">Опції</sys:String>

    <!-- HowLongToBeat -->
    <sys:String x:Key="LOCNortniteHltbShort">HLTB</sys:String>
    <sys:String x:Key="LOCNortniteHltbLong">HowLongToBeat</sys:String>
    <sys:String x:Key="LOCNortniteHltbMain">Сюжет</sys:String>
    <sys:String x:Key="LOCNortniteHltbMainLong">Основний сюжет</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtra">+ дод.</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtraLong">Сюжет + дод.</sys:String>
    <sys:String x:Key="LOCNortniteHltbCompletionist">100%</sys:String>
    <!-- Pasek oceny zamiast HowLongToBeat: krótka etykieta w panelu INFO, długa w szczegółach i opcjach -->
    <sys:String x:Key="LOCNortniteScoreCommunity">Гравці</sys:String>
    <sys:String x:Key="LOCNortniteScoreCritic">Критики</sys:String>
    <sys:String x:Key="LOCNortniteScoreCommunityLong">Оцінка гравців</sys:String>
    <sys:String x:Key="LOCNortniteScoreCriticLong">Оцінка критиків</sys:String>

    <!-- Game details, game menu, launch screen -->
    <sys:String x:Key="LOCNortniteGameDetailsTitle">ПРО ГРУ</sys:String>
    <sys:String x:Key="LOCNortniteGameMenuTitle">МЕНЮ ГРИ</sys:String>
    <sys:String x:Key="LOCNortniteMainMenuTitle">Головне меню</sys:String>
    <sys:String x:Key="LOCNortniteLaunchingTitle">ЗАПУСК</sys:String>
    <sys:String x:Key="LOCNortniteLoadingProgram">Завантаження програми…</sys:String>
    <sys:String x:Key="LOCNortniteConventionalMemory">Основна пам&apos;ять</sys:String>
    <sys:String x:Key="LOCNortniteDrivers">Драйвери</sys:String>
    <sys:String x:Key="LOCNortniteStatusOk">OK</sys:String>
    <sys:String x:Key="LOCNortniteNavigate">Навігація</sys:String>
    <sys:String x:Key="LOCNortniteCloseHint">закрити</sys:String>
    <sys:String x:Key="LOCNortniteFiltersTitle">ФІЛЬТРИ</sys:String>
    <sys:String x:Key="LOCNortniteAdditionalFiltersTitle">ДОД. ФІЛЬТРИ</sys:String>
    <sys:String x:Key="LOCNortniteNotificationInfo">ІНФО</sys:String>
    <sys:String x:Key="LOCNortniteNotificationError">ПОМИЛКА</sys:String>
    <sys:String x:Key="LOCNortniteSettingsTitle">НАЛАШТУВАННЯ</sys:String>
    <!-- Theme options (Theme Options extension, options.yaml) -->
    <sys:String x:Key="LOCNortniteOptPalette">Колірна палітра</sys:String>
    <sys:String x:Key="LOCNortnitePaletteNorton">NORTON</sys:String>
    <sys:String x:Key="LOCNortnitePaletteBios">BIOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteMsDos">MS-DOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSynthwave">SYNTHWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteOutrun">OUTRUN</sys:String>
    <sys:String x:Key="LOCNortnitePaletteVaporwave">VAPORWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSunset">SUNSET</sys:String>
    <sys:String x:Key="LOCNortnitePaletteArizona">ARIZONA</sys:String>
    <sys:String x:Key="LOCNortniteOptListSize">Розмір списку ігор</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeCompact">Компактний</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeNormal">Звичайний</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeLarge">Великий</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn">Друга колонка списку</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTarget">Смуга HowLongToBeat показує</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetMain">Основний сюжет</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetExtra">Сюжет + дод. завдання</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetCompletionist">Проходження на 100%</sys:String>
    <sys:String x:Key="LOCNortniteOptInfoBar">Смуга під даними гри</sys:String>
    <sys:String x:Key="LOCNortniteOptLaunchScreen">Екран запуску гри</sys:String>
    <sys:String x:Key="LOCNortniteOptShow">Показувати</sys:String>
    <sys:String x:Key="LOCNortniteOptHide">Сховати</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPath">Шлях у командному рядку</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathInstall">Тека встановлення гри</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathPreset">Шлях пресету</sys:String>
    <sys:String x:Key="LOCNortniteOptCursor">Курсор командного рядка</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorBlinking">Блимаючий</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorSteady">Постійний</sys:String>
    <!-- C:\>MEM panel under the cover -->
    <sys:String x:Key="LOCNortniteMemInstalled">[■] Встановлена</sys:String>
    <sys:String x:Key="LOCNortniteMemNotInstalled">[ ] Не встановлена</sys:String>
    <sys:String x:Key="LOCNortniteMemSize">Розмір</sys:String>
    <sys:String x:Key="LOCNortniteMemSizeError">ПОМИЛКА</sys:String>
    <sys:String x:Key="LOCNortniteMemReleased">Випуск</sys:String>
    <!-- Size with one decimal place: the number is in tenths of the unit,
         ',' is this language's decimal separator (e.g. 337 → 33,7) -->
    <sys:String x:Key="LOCNortniteSizeGbFormat">{0:0&apos;,&apos;0} ГБ</sys:String>
    <sys:String x:Key="LOCNortniteSizeMbFormat">{0:0&apos;,&apos;0} МБ</sys:String>
    <!-- Play time, compact (game list column is 120 px): {0} = hours, {1} = minutes.
         Keep it as short as "999h 59m"; under one hour only minutes are shown. -->
    <sys:String x:Key="LOCNortniteTimeHoursFormat">{0}г {1}хв</sys:String>
    <sys:String x:Key="LOCNortniteTimeMinutesFormat">{0}хв</sys:String>
</ResourceDictionary>
