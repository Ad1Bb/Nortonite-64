<?xml version="1.0" encoding="utf-8"?>
<!-- Nortonite 64: theme strings, Portuguese (Brazil). Keys missing here fall back to en_US.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Decorative path: <DriveRoot><PRESET NAME>> start <game> -->
    <sys:String x:Key="LOCNortniteDriveRoot">C:\JOGOS\</sys:String>
    <sys:String x:Key="LOCNortniteFilesCount" xml:space="preserve"> arquivo(s)</sys:String>
    <sys:String x:Key="LOCNortniteSelectHint">selecionar</sys:String>

    <!-- Main view -->
    <sys:String x:Key="LOCNortniteMenu">Menu</sys:String>
    <sys:String x:Key="LOCNortniteUpdate">Atualização</sys:String>
    <sys:String x:Key="LOCNortniteInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteColumnLibrary">Biblioteca</sys:String>
    <sys:String x:Key="LOCNortniteColumnPlatform">Plataforma</sys:String>
    <sys:String x:Key="LOCNortniteColumnGenre">Gênero</sys:String>
    <sys:String x:Key="LOCNortniteColumnDeveloper">Estúdio</sys:String>
    <sys:String x:Key="LOCNortniteColumnYear">Ano</sys:String>
    <sys:String x:Key="LOCNortniteColumnAdded">Adicionado</sys:String>
    <sys:String x:Key="LOCNortniteColumnLastPlayed">Jogado</sys:String>
    <sys:String x:Key="LOCNortniteColumnStatus">Status</sys:String>
    <sys:String x:Key="LOCNortniteColumnTime">Tempo</sys:String>
    <sys:String x:Key="LOCNortniteScores">Comunidade / crítica</sys:String>
    <sys:String x:Key="LOCNortnitePreset">Predefinição</sys:String>
    <!-- Buttons under the game info and their pad hints. Keep them SHORT: the button row
         is 666 px wide and must fit on one line in every language, also with "Install"
         (about 22 Latin characters for the longer of Play/Install + Details + Options). -->
    <sys:String x:Key="LOCNortniteButtonPlay">Jogar</sys:String>
    <sys:String x:Key="LOCNortniteButtonInstall">Instalar</sys:String>
    <sys:String x:Key="LOCNortniteButtonDetails">Detalhes</sys:String>
    <sys:String x:Key="LOCNortniteButtonOptions">Opções</sys:String>

    <!-- HowLongToBeat -->
    <sys:String x:Key="LOCNortniteHltbShort">HLTB</sys:String>
    <sys:String x:Key="LOCNortniteHltbLong">HowLongToBeat</sys:String>
    <sys:String x:Key="LOCNortniteHltbMain">História</sys:String>
    <sys:String x:Key="LOCNortniteHltbMainLong">História principal</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtra">+ extras</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtraLong">História + extras</sys:String>
    <sys:String x:Key="LOCNortniteHltbCompletionist">100%</sys:String>
    <!-- Pasek oceny zamiast HowLongToBeat: krótka etykieta w panelu INFO, długa w szczegółach i opcjach -->
    <sys:String x:Key="LOCNortniteScoreCommunity">Jogadores</sys:String>
    <sys:String x:Key="LOCNortniteScoreCritic">Crítica</sys:String>
    <sys:String x:Key="LOCNortniteScoreCommunityLong">Nota dos jogadores</sys:String>
    <sys:String x:Key="LOCNortniteScoreCriticLong">Nota da crítica</sys:String>

    <!-- Game details, game menu, launch screen -->
    <sys:String x:Key="LOCNortniteGameDetailsTitle">DETALHES DO JOGO</sys:String>
    <sys:String x:Key="LOCNortniteGameMenuTitle">MENU DO JOGO</sys:String>
    <sys:String x:Key="LOCNortniteMainMenuTitle">Menu principal</sys:String>
    <sys:String x:Key="LOCNortniteLaunchingTitle">INICIANDO</sys:String>
    <sys:String x:Key="LOCNortniteLoadingProgram">Carregando programa…</sys:String>
    <sys:String x:Key="LOCNortniteConventionalMemory">Memória convencional</sys:String>
    <sys:String x:Key="LOCNortniteDrivers">Drivers</sys:String>
    <sys:String x:Key="LOCNortniteStatusOk">OK</sys:String>
    <sys:String x:Key="LOCNortniteNavigate">Navegar</sys:String>
    <sys:String x:Key="LOCNortniteCloseHint">fechar</sys:String>
    <sys:String x:Key="LOCNortniteFiltersTitle">FILTROS</sys:String>
    <sys:String x:Key="LOCNortniteAdditionalFiltersTitle">MAIS FILTROS</sys:String>
    <sys:String x:Key="LOCNortniteNotificationInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteNotificationError">ERRO</sys:String>
    <sys:String x:Key="LOCNortniteSettingsTitle">CONFIGURAÇÕES</sys:String>
    <!-- Theme options (Theme Options extension, options.yaml) -->
    <sys:String x:Key="LOCNortniteOptPalette">Paleta de cores</sys:String>
    <sys:String x:Key="LOCNortnitePaletteNorton">NORTON</sys:String>
    <sys:String x:Key="LOCNortnitePaletteBios">BIOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteMsDos">MS-DOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSynthwave">SYNTHWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteOutrun">OUTRUN</sys:String>
    <sys:String x:Key="LOCNortnitePaletteVaporwave">VAPORWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSunset">SUNSET</sys:String>
    <sys:String x:Key="LOCNortnitePaletteArizona">ARIZONA</sys:String>
    <sys:String x:Key="LOCNortniteOptListSize">Tamanho da lista de jogos</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeCompact">Compacta</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeNormal">Normal</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeLarge">Grande</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn">Segunda coluna da lista</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn3">Terceira coluna da lista</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTarget">A barra do HowLongToBeat mede</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetMain">História principal</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetExtra">História + extras</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetCompletionist">Completista</sys:String>
    <sys:String x:Key="LOCNortniteOptInfoBar">Barra abaixo dos dados do jogo</sys:String>
    <sys:String x:Key="LOCNortniteOptLaunchScreen">Tela de inicialização do jogo</sys:String>
    <sys:String x:Key="LOCNortniteOptShow">Mostrar</sys:String>
    <sys:String x:Key="LOCNortniteOptHide">Ocultar</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPath">Caminho na linha de comando</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathInstall">Pasta de instalação do jogo</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathPreset">Caminho da predefinição</sys:String>
    <sys:String x:Key="LOCNortniteOptCursor">Cursor da linha de comando</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorBlinking">Piscante</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorSteady">Fixo</sys:String>
    <!-- C:\>MEM panel under the cover -->
    <sys:String x:Key="LOCNortniteMemInstalled">[■] Instalado</sys:String>
    <sys:String x:Key="LOCNortniteMemNotInstalled">[ ] Não instalado</sys:String>
    <sys:String x:Key="LOCNortniteMemSize">Tamanho</sys:String>
    <sys:String x:Key="LOCNortniteMemSizeError">ERRO</sys:String>
    <sys:String x:Key="LOCNortniteMemReleased">Lançamento</sys:String>
    <!-- Size with one decimal place: the number is in tenths of the unit,
         ',' is this language's decimal separator (e.g. 337 → 33,7) -->
    <sys:String x:Key="LOCNortniteSizeGbFormat">{0:0&apos;,&apos;0} GB</sys:String>
    <sys:String x:Key="LOCNortniteSizeMbFormat">{0:0&apos;,&apos;0} MB</sys:String>
    <!-- Play time, compact (game list column is 120 px): {0} = hours, {1} = minutes.
         Keep it as short as "999h 59m"; under one hour only minutes are shown. -->
    <sys:String x:Key="LOCNortniteTimeHoursFormat">{0}h {1}m</sys:String>
    <sys:String x:Key="LOCNortniteTimeMinutesFormat">{0}m</sys:String>
</ResourceDictionary>
