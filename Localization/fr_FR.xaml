<?xml version="1.0" encoding="utf-8"?>
<!-- Nortonite 64: theme strings, French. Keys missing here fall back to en_US.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Decorative path: <DriveRoot><PRESET NAME>> start <game> -->
    <sys:String x:Key="LOCNortniteDriveRoot">C:\JEUX\</sys:String>
    <sys:String x:Key="LOCNortniteFilesCount" xml:space="preserve"> fichier(s)</sys:String>
    <sys:String x:Key="LOCNortniteSelectHint">sélection</sys:String>

    <!-- Main view -->
    <sys:String x:Key="LOCNortniteMenu">Menu</sys:String>
    <sys:String x:Key="LOCNortniteUpdate">Mise à jour</sys:String>
    <sys:String x:Key="LOCNortniteInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteColumnLibrary">Source</sys:String>
    <sys:String x:Key="LOCNortniteColumnPlatform">Plateforme</sys:String>
    <sys:String x:Key="LOCNortniteColumnGenre">Genre</sys:String>
    <sys:String x:Key="LOCNortniteColumnDeveloper">Développeur</sys:String>
    <sys:String x:Key="LOCNortniteColumnYear">Année</sys:String>
    <sys:String x:Key="LOCNortniteColumnAdded">Ajouté</sys:String>
    <sys:String x:Key="LOCNortniteColumnLastPlayed">Joué</sys:String>
    <sys:String x:Key="LOCNortniteColumnStatus">Statut</sys:String>
    <sys:String x:Key="LOCNortniteColumnTime">Temps</sys:String>
    <sys:String x:Key="LOCNortniteScores">Communauté / critiques</sys:String>
    <sys:String x:Key="LOCNortnitePreset">Préréglage</sys:String>
    <!-- Buttons under the game info and their pad hints. Keep them SHORT: the button row
         is 666 px wide and must fit on one line in every language, also with "Install"
         (about 22 Latin characters for the longer of Play/Install + Details + Options). -->
    <sys:String x:Key="LOCNortniteButtonPlay">Jouer</sys:String>
    <sys:String x:Key="LOCNortniteButtonInstall">Installer</sys:String>
    <sys:String x:Key="LOCNortniteButtonDetails">Infos</sys:String>
    <sys:String x:Key="LOCNortniteButtonOptions">Options</sys:String>

    <!-- HowLongToBeat -->
    <sys:String x:Key="LOCNortniteHltbShort">HLTB</sys:String>
    <sys:String x:Key="LOCNortniteHltbLong">HowLongToBeat</sys:String>
    <sys:String x:Key="LOCNortniteHltbMain">Histoire</sys:String>
    <sys:String x:Key="LOCNortniteHltbMainLong">Histoire principale</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtra">+ extras</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtraLong">Histoire + extras</sys:String>
    <sys:String x:Key="LOCNortniteHltbCompletionist">100%</sys:String>
    <!-- Pasek oceny zamiast HowLongToBeat: krótka etykieta w panelu INFO, długa w szczegółach i opcjach -->
    <sys:String x:Key="LOCNortniteScoreCommunity">Joueurs</sys:String>
    <sys:String x:Key="LOCNortniteScoreCritic">Critiques</sys:String>
    <sys:String x:Key="LOCNortniteScoreCommunityLong">Note des joueurs</sys:String>
    <sys:String x:Key="LOCNortniteScoreCriticLong">Note des critiques</sys:String>

    <!-- Game details, game menu, launch screen -->
    <sys:String x:Key="LOCNortniteGameDetailsTitle">DÉTAILS DU JEU</sys:String>
    <sys:String x:Key="LOCNortniteGameMenuTitle">MENU DU JEU</sys:String>
    <sys:String x:Key="LOCNortniteMainMenuTitle">Menu principal</sys:String>
    <sys:String x:Key="LOCNortniteLaunchingTitle">LANCEMENT</sys:String>
    <sys:String x:Key="LOCNortniteLoadingProgram">Chargement du programme…</sys:String>
    <sys:String x:Key="LOCNortniteConventionalMemory">Mémoire conventionnelle</sys:String>
    <sys:String x:Key="LOCNortniteDrivers">Pilotes</sys:String>
    <sys:String x:Key="LOCNortniteStatusOk">OK</sys:String>
    <sys:String x:Key="LOCNortniteNavigate">Navigation</sys:String>
    <sys:String x:Key="LOCNortniteCloseHint">fermer</sys:String>
    <sys:String x:Key="LOCNortniteFiltersTitle">FILTRES</sys:String>
    <sys:String x:Key="LOCNortniteAdditionalFiltersTitle">AUTRES FILTRES</sys:String>
    <sys:String x:Key="LOCNortniteNotificationInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteNotificationError">ERREUR</sys:String>
    <sys:String x:Key="LOCNortniteSettingsTitle">PARAMÈTRES</sys:String>
    <!-- Theme options (Theme Options extension, options.yaml) -->
    <sys:String x:Key="LOCNortniteOptPalette">Palette de couleurs</sys:String>
    <sys:String x:Key="LOCNortnitePaletteNorton">NORTON</sys:String>
    <sys:String x:Key="LOCNortnitePaletteBios">BIOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteMsDos">MS-DOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSynthwave">SYNTHWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteOutrun">OUTRUN</sys:String>
    <sys:String x:Key="LOCNortnitePaletteVaporwave">VAPORWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSunset">SUNSET</sys:String>
    <sys:String x:Key="LOCNortnitePaletteArizona">ARIZONA</sys:String>
    <sys:String x:Key="LOCNortniteOptListSize">Taille de la liste des jeux</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeCompact">Compacte</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeNormal">Normale</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeLarge">Grande</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn">Deuxième colonne de la liste</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn3">Troisième colonne de la liste</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTarget">La barre HowLongToBeat mesure</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetMain">Histoire principale</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetExtra">Histoire + extras</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetCompletionist">Complétionniste</sys:String>
    <sys:String x:Key="LOCNortniteOptInfoBar">Barre sous les infos du jeu</sys:String>
    <sys:String x:Key="LOCNortniteOptLaunchScreen">Écran de lancement du jeu</sys:String>
    <sys:String x:Key="LOCNortniteOptShow">Afficher</sys:String>
    <sys:String x:Key="LOCNortniteOptHide">Masquer</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPath">Chemin dans la ligne de commande</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathInstall">Dossier d&apos;installation du jeu</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathPreset">Chemin du préréglage</sys:String>
    <sys:String x:Key="LOCNortniteOptCursor">Curseur de la ligne de commande</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorBlinking">Clignotant</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorSteady">Fixe</sys:String>
    <!-- C:\>MEM panel under the cover -->
    <sys:String x:Key="LOCNortniteMemInstalled">[■] Installé</sys:String>
    <sys:String x:Key="LOCNortniteMemNotInstalled">[ ] Non installé</sys:String>
    <sys:String x:Key="LOCNortniteMemSize">Taille</sys:String>
    <sys:String x:Key="LOCNortniteMemSizeError">ERREUR</sys:String>
    <sys:String x:Key="LOCNortniteMemReleased">Sortie</sys:String>
    <!-- Size with one decimal place: the number is in tenths of the unit,
         ',' is this language's decimal separator (e.g. 337 → 33,7) -->
    <sys:String x:Key="LOCNortniteSizeGbFormat">{0:0&apos;,&apos;0} Go</sys:String>
    <sys:String x:Key="LOCNortniteSizeMbFormat">{0:0&apos;,&apos;0} Mo</sys:String>
    <!-- Play time, compact (game list column is 120 px): {0} = hours, {1} = minutes.
         Keep it as short as "999h 59m"; under one hour only minutes are shown. -->
    <sys:String x:Key="LOCNortniteTimeHoursFormat">{0}h {1}m</sys:String>
    <sys:String x:Key="LOCNortniteTimeMinutesFormat">{0}m</sys:String>
</ResourceDictionary>
