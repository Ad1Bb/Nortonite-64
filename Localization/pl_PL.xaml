<?xml version="1.0" encoding="utf-8"?>
<!-- Nortonite 64: teksty motywu, polski. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Ozdobna ścieżka: <DriveRoot><NAZWA PRESETU>> start <gra> -->
    <sys:String x:Key="LOCNortniteDriveRoot">C:\GRY\</sys:String>
    <sys:String x:Key="LOCNortniteFilesCount" xml:space="preserve"> plik(ów)</sys:String>
    <sys:String x:Key="LOCNortniteSelectHint">wybór</sys:String>

    <!-- Widok główny -->
    <sys:String x:Key="LOCNortniteMenu">Menu</sys:String>
    <sys:String x:Key="LOCNortniteUpdate">Aktualizacja</sys:String>
    <sys:String x:Key="LOCNortniteInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteColumnLibrary">Biblioteka</sys:String>
    <sys:String x:Key="LOCNortniteColumnPlatform">Platforma</sys:String>
    <sys:String x:Key="LOCNortniteColumnGenre">Gatunek</sys:String>
    <sys:String x:Key="LOCNortniteColumnDeveloper">Producent</sys:String>
    <sys:String x:Key="LOCNortniteColumnYear">Rok</sys:String>
    <sys:String x:Key="LOCNortniteColumnAdded">Dodano</sys:String>
    <sys:String x:Key="LOCNortniteColumnLastPlayed">Grano</sys:String>
    <sys:String x:Key="LOCNortniteColumnStatus">Status</sys:String>
    <sys:String x:Key="LOCNortniteColumnTime">Czas</sys:String>
    <sys:String x:Key="LOCNortniteScores">Ocena społ. / kryt.</sys:String>
    <sys:String x:Key="LOCNortnitePreset">Preset</sys:String>
    <!-- Przyciski pod danymi gry i ich opisy na belce pada. Teksty KRÓTKIE: rząd przycisków
         ma 666 px i musi się zmieścić w jednej linii także z „Instaluj”. -->
    <sys:String x:Key="LOCNortniteButtonPlay">Graj</sys:String>
    <sys:String x:Key="LOCNortniteButtonInstall">Instaluj</sys:String>
    <sys:String x:Key="LOCNortniteButtonDetails">Szczegóły</sys:String>
    <sys:String x:Key="LOCNortniteButtonOptions">Opcje</sys:String>

    <!-- HowLongToBeat -->
    <sys:String x:Key="LOCNortniteHltbShort">HLTB</sys:String>
    <sys:String x:Key="LOCNortniteHltbLong">HowLongToBeat</sys:String>
    <sys:String x:Key="LOCNortniteHltbMain">Fabuła</sys:String>
    <sys:String x:Key="LOCNortniteHltbMainLong">Fabuła</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtra">+ dodatki</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtraLong">Fabuła + dodatki</sys:String>
    <sys:String x:Key="LOCNortniteHltbCompletionist">100%</sys:String>
    <!-- Pasek oceny zamiast HowLongToBeat: krótka etykieta w panelu INFO, długa w szczegółach i opcjach -->
    <sys:String x:Key="LOCNortniteScoreCommunity">Gracze</sys:String>
    <sys:String x:Key="LOCNortniteScoreCritic">Krytycy</sys:String>
    <sys:String x:Key="LOCNortniteScoreCommunityLong">Ocena graczy</sys:String>
    <sys:String x:Key="LOCNortniteScoreCriticLong">Ocena krytyków</sys:String>

    <!-- Szczegóły gry, menu gry, ekran uruchamiania -->
    <sys:String x:Key="LOCNortniteGameDetailsTitle">SZCZEGÓŁY GRY</sys:String>
    <sys:String x:Key="LOCNortniteGameMenuTitle">MENU GRY</sys:String>
    <sys:String x:Key="LOCNortniteMainMenuTitle">Menu główne</sys:String>
    <sys:String x:Key="LOCNortniteLaunchingTitle">URUCHAMIANIE</sys:String>
    <sys:String x:Key="LOCNortniteLoadingProgram">Ładowanie programu…</sys:String>
    <sys:String x:Key="LOCNortniteConventionalMemory">Pamięć konwencjonalna</sys:String>
    <sys:String x:Key="LOCNortniteDrivers">Sterowniki</sys:String>
    <sys:String x:Key="LOCNortniteStatusOk">OK</sys:String>
    <sys:String x:Key="LOCNortniteNavigate">Nawigacja</sys:String>
    <sys:String x:Key="LOCNortniteCloseHint">zamknij</sys:String>
    <sys:String x:Key="LOCNortniteFiltersTitle">FILTRY</sys:String>
    <sys:String x:Key="LOCNortniteAdditionalFiltersTitle">FILTRY DODATKOWE</sys:String>
    <sys:String x:Key="LOCNortniteNotificationInfo">INFO</sys:String>
    <sys:String x:Key="LOCNortniteNotificationError">BŁĄD</sys:String>
    <sys:String x:Key="LOCNortniteSettingsTitle">USTAWIENIA</sys:String>
    <!-- Opcje motywu (dodatek Theme Options, options.yaml) -->
    <sys:String x:Key="LOCNortniteOptPalette">Paleta kolorów</sys:String>
    <sys:String x:Key="LOCNortnitePaletteNorton">NORTON</sys:String>
    <sys:String x:Key="LOCNortnitePaletteBios">BIOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteMsDos">MS-DOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSynthwave">SYNTHWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteOutrun">OUTRUN</sys:String>
    <sys:String x:Key="LOCNortnitePaletteVaporwave">VAPORWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSunset">SUNSET</sys:String>
    <sys:String x:Key="LOCNortnitePaletteArizona">ARIZONA</sys:String>
    <sys:String x:Key="LOCNortniteOptListSize">Wielkość listy gier</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeCompact">Kompaktowa</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeNormal">Normalna</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeLarge">Duża</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn">Druga kolumna listy</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn3">Trzecia kolumna listy</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTarget">Pasek HowLongToBeat mierzy</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetMain">Fabułę</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetExtra">Fabułę z dodatkami</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetCompletionist">100% gry</sys:String>
    <sys:String x:Key="LOCNortniteOptInfoBar">Pasek pod danymi gry</sys:String>
    <sys:String x:Key="LOCNortniteOptLaunchScreen">Ekran uruchamiania gry</sys:String>
    <sys:String x:Key="LOCNortniteOptShow">Pokazuj</sys:String>
    <sys:String x:Key="LOCNortniteOptHide">Ukryj</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPath">Ścieżka w wierszu poleceń</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathInstall">Folder instalacji gry</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathPreset">Ścieżka presetu</sys:String>
    <sys:String x:Key="LOCNortniteOptCursor">Kursor w wierszu poleceń</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorBlinking">Migający</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorSteady">Stały</sys:String>
    <!-- Panel C:\>MEM pod okładką -->
    <sys:String x:Key="LOCNortniteMemInstalled">[■] Zainstalowana</sys:String>
    <sys:String x:Key="LOCNortniteMemNotInstalled">[ ] Niezainstalowana</sys:String>
    <sys:String x:Key="LOCNortniteMemSize">Rozmiar</sys:String>
    <sys:String x:Key="LOCNortniteMemSizeError">BŁĄD</sys:String>
    <sys:String x:Key="LOCNortniteMemReleased">Wydano</sys:String>
    <!-- Rozmiar z jednym miejscem po przecinku: liczba w dziesiątych częściach jednostki,
         ',' to separator dziesiętny tego języka (np. 337 → 33,7 GB) -->
    <sys:String x:Key="LOCNortniteSizeGbFormat">{0:0','0} GB</sys:String>
    <sys:String x:Key="LOCNortniteSizeMbFormat">{0:0','0} MB</sys:String>
    <!-- Czas gry, zwięźle (kolumna na liście ma 120 px): {0} = godziny, {1} = minuty -->
    <sys:String x:Key="LOCNortniteTimeHoursFormat">{0}h {1}m</sys:String>
    <sys:String x:Key="LOCNortniteTimeMinutesFormat">{0}m</sys:String>
</ResourceDictionary>
