<?xml version="1.0" encoding="utf-8"?>
<!-- Nortonite 64: theme strings, Japanese. Keys missing here fall back to en_US.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Decorative path: <DriveRoot><PRESET NAME>> start <game> -->
    <sys:String x:Key="LOCNortniteDriveRoot">C:\GAMES\</sys:String>
    <sys:String x:Key="LOCNortniteFilesCount" xml:space="preserve"> ファイル</sys:String>
    <sys:String x:Key="LOCNortniteSelectHint">選択</sys:String>

    <!-- Main view -->
    <sys:String x:Key="LOCNortniteMenu">メニュー</sys:String>
    <sys:String x:Key="LOCNortniteUpdate">アップデート</sys:String>
    <sys:String x:Key="LOCNortniteInfo">情報</sys:String>
    <sys:String x:Key="LOCNortniteColumnTime">時間</sys:String>
    <sys:String x:Key="LOCNortniteScores">ユーザー / 評論家</sys:String>
    <sys:String x:Key="LOCNortnitePreset">プリセット</sys:String>
    <!-- Buttons under the game info and their pad hints. Keep them SHORT: the button row
         is 666 px wide and must fit on one line in every language, also with "Install"
         (about 22 Latin characters for the longer of Play/Install + Details + Options). -->
    <sys:String x:Key="LOCNortniteButtonPlay">プレイ</sys:String>
    <sys:String x:Key="LOCNortniteButtonInstall">インストール</sys:String>
    <sys:String x:Key="LOCNortniteButtonDetails">詳細</sys:String>
    <sys:String x:Key="LOCNortniteButtonOptions">設定</sys:String>

    <!-- HowLongToBeat -->
    <sys:String x:Key="LOCNortniteHltbShort">HLTB</sys:String>
    <sys:String x:Key="LOCNortniteHltbLong">HowLongToBeat</sys:String>
    <sys:String x:Key="LOCNortniteHltbMain">メイン</sys:String>
    <sys:String x:Key="LOCNortniteHltbMainLong">メインストーリー</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtra">+ サイド</sys:String>
    <sys:String x:Key="LOCNortniteHltbExtraLong">メイン + サイド</sys:String>
    <sys:String x:Key="LOCNortniteHltbCompletionist">100%</sys:String>
    <!-- Pasek oceny zamiast HowLongToBeat: krótka etykieta w panelu INFO, długa w szczegółach i opcjach -->
    <sys:String x:Key="LOCNortniteScoreCommunity">ユーザー</sys:String>
    <sys:String x:Key="LOCNortniteScoreCritic">批評家</sys:String>
    <sys:String x:Key="LOCNortniteScoreCommunityLong">ユーザースコア</sys:String>
    <sys:String x:Key="LOCNortniteScoreCriticLong">批評家スコア</sys:String>

    <!-- Game details, game menu, launch screen -->
    <sys:String x:Key="LOCNortniteGameDetailsTitle">ゲーム詳細</sys:String>
    <sys:String x:Key="LOCNortniteGameMenuTitle">ゲームメニュー</sys:String>
    <sys:String x:Key="LOCNortniteMainMenuTitle">メインメニュー</sys:String>
    <sys:String x:Key="LOCNortniteLaunchingTitle">起動中</sys:String>
    <sys:String x:Key="LOCNortniteLoadingProgram">プログラムを読み込み中…</sys:String>
    <sys:String x:Key="LOCNortniteConventionalMemory">コンベンショナルメモリ</sys:String>
    <sys:String x:Key="LOCNortniteDrivers">ドライバー</sys:String>
    <sys:String x:Key="LOCNortniteStatusOk">OK</sys:String>
    <sys:String x:Key="LOCNortniteNavigate">移動</sys:String>
    <sys:String x:Key="LOCNortniteCloseHint">閉じる</sys:String>
    <sys:String x:Key="LOCNortniteFiltersTitle">フィルター</sys:String>
    <sys:String x:Key="LOCNortniteAdditionalFiltersTitle">その他のフィルター</sys:String>
    <sys:String x:Key="LOCNortniteNotificationInfo">情報</sys:String>
    <sys:String x:Key="LOCNortniteNotificationError">エラー</sys:String>
    <sys:String x:Key="LOCNortniteSettingsTitle">設定</sys:String>
    <!-- Theme options (Theme Options extension, options.yaml) -->
    <sys:String x:Key="LOCNortniteOptPalette">カラーパレット</sys:String>
    <sys:String x:Key="LOCNortnitePaletteNorton">NORTON</sys:String>
    <sys:String x:Key="LOCNortnitePaletteBios">BIOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteMsDos">MS-DOS</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSynthwave">SYNTHWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteOutrun">OUTRUN</sys:String>
    <sys:String x:Key="LOCNortnitePaletteVaporwave">VAPORWAVE</sys:String>
    <sys:String x:Key="LOCNortnitePaletteSunset">SUNSET</sys:String>
    <sys:String x:Key="LOCNortnitePaletteArizona">ARIZONA</sys:String>
    <sys:String x:Key="LOCNortniteOptListSize">ゲームリストのサイズ</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeCompact">コンパクト</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeNormal">標準</sys:String>
    <sys:String x:Key="LOCNortniteOptListSizeLarge">大</sys:String>
    <sys:String x:Key="LOCNortniteOptListColumn">リストの2列目</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTarget">HowLongToBeat バーの基準</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetMain">メインストーリー</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetExtra">メイン + サイド</sys:String>
    <sys:String x:Key="LOCNortniteOptHltbTargetCompletionist">完全クリア</sys:String>
    <sys:String x:Key="LOCNortniteOptInfoBar">ゲーム情報の下のバー</sys:String>
    <sys:String x:Key="LOCNortniteOptLaunchScreen">ゲーム起動画面</sys:String>
    <sys:String x:Key="LOCNortniteOptShow">表示</sys:String>
    <sys:String x:Key="LOCNortniteOptHide">非表示</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPath">コマンドラインのパス</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathInstall">ゲームのインストールフォルダー</sys:String>
    <sys:String x:Key="LOCNortniteOptCmdPathPreset">プリセットのパス</sys:String>
    <sys:String x:Key="LOCNortniteOptCursor">コマンドラインのカーソル</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorBlinking">点滅</sys:String>
    <sys:String x:Key="LOCNortniteOptCursorSteady">常時表示</sys:String>
    <!-- C:\>MEM panel under the cover -->
    <sys:String x:Key="LOCNortniteMemInstalled">[■] インストール済み</sys:String>
    <sys:String x:Key="LOCNortniteMemNotInstalled">[ ] 未インストール</sys:String>
    <sys:String x:Key="LOCNortniteMemSize">サイズ</sys:String>
    <sys:String x:Key="LOCNortniteMemSizeError">エラー</sys:String>
    <sys:String x:Key="LOCNortniteMemReleased">発売</sys:String>
    <!-- Size with one decimal place: the number is in tenths of the unit,
         '.' is this language's decimal separator (e.g. 337 → 33.7 GB) -->
    <sys:String x:Key="LOCNortniteSizeGbFormat">{0:0&apos;.&apos;0} GB</sys:String>
    <sys:String x:Key="LOCNortniteSizeMbFormat">{0:0&apos;.&apos;0} MB</sys:String>
    <!-- Play time, compact (game list column is 120 px): {0} = hours, {1} = minutes.
         Keep it as short as "999h 59m"; under one hour only minutes are shown. -->
    <sys:String x:Key="LOCNortniteTimeHoursFormat">{0}h {1}m</sys:String>
    <sys:String x:Key="LOCNortniteTimeMinutesFormat">{0}m</sys:String>
</ResourceDictionary>
