<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Nortonite 64: zawartość wiersza listy gier.
         Kolumny: nazwa | druga kolumna | trzecia kolumna (do wyboru w opcjach motywu).
         Szerokości kolumn muszą się zgadzać z nagłówkiem w Views/Main.xaml. -->
    <Style x:Key="ListGameItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Grid d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                        <!-- Kolumny: nazwa (*) │ druga │ trzecia. Druga i trzecia to komórki do wyboru w opcjach
                             motywu (Tag = NortniteListColumn2 / NortniteListColumn3, styl NortniteListCellStyle
                             w Constants.xaml): komórka ma własną szerokość i odstęp 12 jako margines, a ukryta
                             znika razem z odstępem. Trzecia kolumna jest wyrównana do prawej. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TextName" Grid.Column="0"
                                   Style="{StaticResource NortniteListTextStyle}"
                                   Foreground="{DynamicResource NortniteBrightBrush}"
                                   Text="{Binding DisplayName}" />

                        <ContentControl x:Name="Column2" Grid.Column="1" Content="{Binding}"
                                        Style="{StaticResource NortniteListCellStyle}"
                                        Tag="{DynamicResource NortniteListColumn2}"
                                        HorizontalContentAlignment="Left" />
                        <ContentControl x:Name="Column3" Grid.Column="2" Content="{Binding}"
                                        Style="{StaticResource NortniteListCellStyle}"
                                        Tag="{DynamicResource NortniteListColumn3}"
                                        HorizontalContentAlignment="Right" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Gra nigdy nieuruchomiona: nazwa turkusowa -->
                        <DataTrigger Binding="{Binding Playtime}" Value="0">
                            <Setter TargetName="TextName" Property="Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
                        </DataTrigger>
                        <!-- Wiersz zaznaczony: czarny tekst na turkusowym tle -->
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="TextName" Property="Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                            <Setter TargetName="Column2" Property="Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                            <Setter TargetName="Column3" Property="Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="TextName" Property="Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                            <Setter TargetName="Column2" Property="Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                            <Setter TargetName="Column3" Property="Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
