<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nortonite 64: zakładka presetu. Aktywny preset odwrócony (turkus/czarny),
         pozostałe białe. Zakładki nie przyjmują fokusu: presety przełącza się LB/RB
         (kliknięcie myszą działa dalej), a fokus na zakładkach przechwytywałby ruch
         padem w prawo z listy gier zamiast trafić na [ GRAJ ]. -->
    <Style x:Key="ItemFilterQuickPreset" TargetType="CheckBoxEx">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource NortniteBrightBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBoxEx">
                    <Grid Margin="0,0,9,0">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="18,1,18,1">
                            <TextBlock x:Name="TextContent" Text="{Binding Name}"
                                       Style="{StaticResource NortniteTextStyle}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <Border x:Name="FocusRing" Margin="-3"
                                BorderBrush="{DynamicResource NortniteAccentBrush}" BorderThickness="3"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NortniteBarBrush}" />
                            <Setter TargetName="TextContent" Property="Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NortniteBarBrush}" />
                            <Setter TargetName="TextContent" Property="Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rząd presetów: LB [zakładki] RB -->
    <Style TargetType="{x:Type FilterPresetSelector}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPresetSelector}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- prawy margines 6 + lewy margines 3 zakładek = odstęp 9 -->
                        <ContentControl Grid.Column="0" Tag="LB" Style="{StaticResource NortnitePadKey}"
                                        Margin="0,0,6,0" Height="36" />

                        <ItemsControlEx x:Name="PART_ItemsFilterPresets" Grid.Column="1" Focusable="False"
                                        KeyboardNavigation.DirectionalNavigation="Once"
                                        HorizontalLayout="True">
                            <ItemsControlEx.MaxWidth>
                                <!-- MathConverter: nazwy funkcji z wielkiej litery (Max, Round) -->
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"
                                         Converter="{StaticResource MathConverter}"
                                         ConverterParameter="Max(x - 150, 0)" />
                            </ItemsControlEx.MaxWidth>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Template>
                                <ControlTemplate>
                                    <!-- ScrollViewer przycina treść do swoich krawędzi, a obwódka zakładki
                                         wystaje 3 px poza nią: margines 3 wokół zakładek ją mieści -->
                                    <ScrollViewer Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter Margin="3" />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                        </ItemsControlEx>

                        <ContentControl Grid.Column="2" Tag="RB" Style="{StaticResource NortnitePadKey}"
                                        Height="36" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
