<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nortonite 64: suwak jako segmentowy pasek "◄ ■■■■□□□ ►" (12 segmentów).
         Fokus: turkusowe tło, czarne strzałki i wypełnienie, żółta obwódka. -->
    <Style x:Key="SliderTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DrawingBrush x:Key="NortniteSliderSegmentMask" TileMode="Tile" Stretch="Fill"
                  Viewport="0,0,0.0833333,1" ViewportUnits="RelativeToBoundingBox">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,100,10" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="Black">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,82,10" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>



    <Style TargetType="Slider">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="45" />
        <Setter Property="Padding" Value="9,0,9,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border x:Name="Bd" Margin="3" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <DockPanel x:Name="Inner"
                                       TextElement.Foreground="{TemplateBinding Foreground}"
                                       TextElement.FontSize="{DynamicResource NortniteFontSize}"
                                       TextElement.FontFamily="{Binding Path=Resources[NortniteFontHolder].Text, Source={x:Static Application.Current}, TargetNullValue=Consolas, FallbackValue=Consolas}">
                                <TextBlock DockPanel.Dock="Left" Text="◄ " VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text=" ►" VerticalAlignment="Center" />
                                <Grid Height="21" VerticalAlignment="Center">
                                    <!-- 12 segmentów: odstępy wycina maska bez koloru -->
                                    <Grid OpacityMask="{StaticResource NortniteSliderSegmentMask}">
                                    <Border x:Name="TrackBg" Background="{DynamicResource NortniteDimBrush}" />
                                    <Border x:Name="TrackFill" HorizontalAlignment="Left"
                                            Background="{DynamicResource NortniteAccentBrush}"
                                            Width="{Binding ActualWidth, ElementName=ButtonDecrease}" />
                                    </Grid>
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Width="3" Style="{StaticResource SliderThumb}" />
                                        </Track.Thumb>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton x:Name="ButtonDecrease"
                                                          Style="{StaticResource SliderTrackButton}"
                                                          Command="Slider.DecreaseLarge" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton x:Name="ButtonIncrease"
                                                          Style="{StaticResource SliderTrackButton}"
                                                          Command="Slider.IncreaseLarge" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <!-- obwódka wewnątrz kontrolki (tło wcięte o 3), bo wiersze na pełną szerokość ucina kontener z przycinaniem (np. okno Theme Options) -->
                        <Border x:Name="FocusRing" Margin="0" BorderThickness="3"
                                BorderBrush="{DynamicResource NortniteAccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NortniteBarBrush}" />
                            <Setter TargetName="Inner" Property="TextElement.Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                            <Setter TargetName="TrackBg" Property="Background" Value="{DynamicResource NortniteBackgroundBrush}" />
                            <Setter TargetName="TrackFill" Property="Background" Value="{DynamicResource NortniteBarForegroundBrush}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="SliderEx" BasedOn="{StaticResource {x:Type Slider}}">
    </Style>
</ResourceDictionary>
