<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nortonite 64 · klienci gier, narzędzia, rozszerzenia: ten sam język co menu główne
         (niebieskie okno, turkusowa ramka, wiersze z odwróconym zaznaczeniem). -->

    <Style x:Key="GameClientMenuButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="15,9,15,9" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="FontSize" Value="33" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{DynamicResource NortniteRowButtonTemplate}" />
        <Setter Property="Margin" Value="15,1.5,15,1.5" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <DockPanel>
                        <ContentControl Content="{Binding Icon}" Width="30" Height="30" Focusable="False"
                                        VerticalAlignment="Center" Margin="0,0,15,0" />
                        <TextBlock Style="{StaticResource NortniteMenuLabel}" Text="{Binding Name}" />
                    </DockPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameClientsBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NortniteBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="TextElement.FontFamily" Value="{Binding Path=Resources[NortniteFontHolder].Text, Source={x:Static Application.Current}, TargetNullValue=Consolas, FallbackValue=Consolas}" />
        <Setter Property="TextElement.FontSize" Value="33" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Width" Value="600" />
        <Setter Property="Padding" Value="0,15,0,15" />
    </Style>

    <Style x:Key="SoftwareToolMenuButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="15,9,15,9" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="FontSize" Value="33" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{DynamicResource NortniteRowButtonTemplate}" />
        <Setter Property="Margin" Value="15,1.5,15,1.5" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <DockPanel>
                        <Image Source="{Binding Icon, Converter={StaticResource ImageStringToImageConverter}}"
                               Width="30" Height="30" Focusable="False"
                               VerticalAlignment="Center" Margin="0,0,15,0" />
                        <TextBlock Style="{StaticResource NortniteMenuLabel}" Text="{Binding Name}" />
                    </DockPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SoftwareToolsBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NortniteBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="TextElement.FontFamily" Value="{Binding Path=Resources[NortniteFontHolder].Text, Source={x:Static Application.Current}, TargetNullValue=Consolas, FallbackValue=Consolas}" />
        <Setter Property="TextElement.FontSize" Value="33" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Width" Value="600" />
        <Setter Property="Padding" Value="0,15,0,15" />
    </Style>

    <Style x:Key="ExtensionMenuButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="15,9,15,9" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="FontSize" Value="33" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{DynamicResource NortniteRowButtonTemplate}" />
        <Setter Property="Margin" Value="15,1.5,15,1.5" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <DockPanel>
                        <ContentControl Content="{Binding Icon}" Width="30" Height="30" Focusable="False"
                                        VerticalAlignment="Center" Margin="0,0,15,0" DockPanel.Dock="Left" />
                        <TextBlock Style="{StaticResource NortniteMenuSubmenuArrow}"
                                   Visibility="{Binding Children, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Style="{StaticResource NortniteMenuLabel}" Text="{Binding Header}" />
                    </DockPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ExtensionsBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NortniteBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="TextElement.FontFamily" Value="{Binding Path=Resources[NortniteFontHolder].Text, Source={x:Static Application.Current}, TargetNullValue=Consolas, FallbackValue=Consolas}" />
        <Setter Property="TextElement.FontSize" Value="33" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Width" Value="600" />
        <Setter Property="Padding" Value="0,15,0,15" />
    </Style>
</ResourceDictionary>
