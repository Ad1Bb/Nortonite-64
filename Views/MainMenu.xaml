<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pmrk="clr-namespace:Playnite.FullscreenApp.Markup;assembly=Playnite.FullscreenApp">

    <!--
        Nortonite 64 · menu główne (makieta 04)
        Układ okna ustala Playnite: pionowy panel przy prawej krawędzi.
        Pozycje systemowe (uśpij, uruchom ponownie, wyłącz, zamknij…) mają biały tekst.
    -->
    <Style x:Key="MainMenuBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NortniteBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="TextElement.FontFamily" Value="{Binding Path=Resources[NortniteFontHolder].Text, Source={x:Static Application.Current}, TargetNullValue=Consolas, FallbackValue=Consolas}" />
        <Setter Property="TextElement.FontSize" Value="33" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Width" Value="450" />
        <Setter Property="BorderThickness" Value="3,0,3,0" />
    </Style>

    <Style x:Key="MainMenuButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="15,9,15,9" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="FontSize" Value="33" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{DynamicResource NortniteRowButtonTemplate}" />
        <Setter Property="Margin" Value="15,1.5,15,1.5" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="MainMenuHeaderTemplate">
        <Border Style="{StaticResource NortniteWindowHeader}" Padding="24,33,24,21" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="PLAYNITE" FontSize="22.5"
                           FontFamily="{Binding Path=Resources[NortniteTitleFontHolder].Text, Source={x:Static Application.Current}, TargetNullValue=Consolas, FallbackValue=Consolas}" />
                <TextBlock Text="{DynamicResource LOCNortniteMainMenuTitle}" FontSize="30" Margin="0,9,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="MainMenuRandomGameButtonTemplate">
        <DockPanel>
            <TextBlock Style="{StaticResource NortniteMenuIcon}" Tag="?" />
            <TextBlock Style="{StaticResource NortniteMenuLabel}" Text="{DynamicResource LOCMenuSelectRandomGame}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="MainMenuLibUpdateButtonTemplate">
        <DockPanel>
            <TextBlock Style="{StaticResource NortniteMenuIcon}" Tag="↻" />
            <TextBlock Style="{StaticResource NortniteMenuLabel}" Text="{DynamicResource LOCMenuReloadLibrary}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="MainMenuCancelLibUpdateButtonTemplate">
        <DockPanel>
            <TextBlock Style="{StaticResource NortniteMenuIcon}" Tag="×" />
            <TextBlock Style="{StaticResource NortniteMenuLabel}" Text="{DynamicResource LOCMenuCancelLibraryUpdate}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="MainMenuSettingsButtonTemplate">
        <DockPanel>
            <TextBlock Style="{StaticResource NortniteMenuIcon}" Tag="≡" />
            <TextBlock Style="{StaticResource NortniteMenuLabel}" Text="{DynamicResource LOCSettingsLabel}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="MainMenuClientsButtonTemplate">
        <DockPanel>
            <TextBlock Style="{StaticResource NortniteMenuIcon}" Tag="▪" />
