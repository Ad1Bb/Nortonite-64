<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Nortonite 64 · panel filtrów (makieta 03)
        Elementy panelu tworzy Playnite (kolejność ustala kod); motyw nadaje im wygląd
        przez style FilterPanel…. Panel zajmuje miejsce lewego panelu listy gier.
    -->

    <!-- Biblioteka / Platforma / Kategoria / Dodatkowe filtry: "etykieta …… ►".
         Tag = True, gdy filtr jest ustawiony: etykieta żółta. -->
    <Style x:Key="FilterPanelNagivationButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="12,6,12,6" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="0,3,0,3" />
        <Setter Property="FontSize" Value="{DynamicResource NortniteFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid x:Name="Inner"
                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                  TextElement.FontFamily="{Binding Path=Resources[NortniteFontHolder].Text, Source={x:Static Application.Current}, TargetNullValue=Consolas, FallbackValue=Consolas}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Label" Grid.Column="0" VerticalAlignment="Center" />
                                <Line x:Name="Leader" Grid.Column="1" Style="{StaticResource NortniteDotLeader}" />
                                <TextBlock Grid.Column="2" Text="►" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" Margin="-3"
                                BorderBrush="{DynamicResource NortniteAccentBrush}"
                                BorderThickness="3" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource NortniteAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NortniteBarBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
                            <Setter TargetName="Leader" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pozycje list podfiltrów ([■] nazwa) -->
    <Style x:Key="FilterItemtSelectionStyle" TargetType="CheckBoxEx" BasedOn="{StaticResource {x:Type CheckBoxEx}}">
        <Setter Property="Margin" Value="0,3,0,3" />
    </Style>

    <!-- Zainstalowane / Niezainstalowane / Ulubione / Ukryte -->
    <Style x:Key="FilterPanelCheckBoxEx" TargetType="CheckBoxEx" BasedOn="{StaticResource {x:Type CheckBoxEx}}">
        <Setter Property="Margin" Value="0,3,0,3" />
    </Style>

    <!-- [ Wyczyść ] -->
    <Style x:Key="FilterPanelButtonEx" TargetType="ButtonEx" BasedOn="{StaticResource {x:Type ButtonEx}}">
        <Setter Property="Margin" Value="6,6,6,12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Foreground" Value="{DynamicResource NortniteAccentBrush}" />
            </Trigger>
            <!-- Przy fokusie tekst FocusForeground na tle FocusFill (Accent byłby nieczytelny) -->
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource NortniteFocusForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sortowanie, kierunek, preset: "etykieta …… wartość ►" (etykieta z AutomationProperties.Name) -->
    <Style x:Key="FilterPanelComboBoxEx" TargetType="ComboBoxEx" BasedOn="{StaticResource {x:Type ComboBoxEx}}">
        <Setter Property="Margin" Value="0,3,0,3" />
    </Style>

    <!-- Osobne etykiety nad listami są zbędne: etykieta jest w wierszu listy -->
    <Style x:Key="FilterPanelText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- [ Zapisz ] [ Zmień nazwę ] [ Usuń ] -->
    <Style x:Key="FilterPanelFilterPresetActionButton" TargetType="ButtonEx" BasedOn="{StaticResource {x:Type ButtonEx}}">
        <Setter Property="Margin" Value="6,9,6,6" />
        <Setter Property="Padding" Value="6,3,6,3" />
        <Setter Property="FontSize" Value="30" />
    </Style>

    <DataTemplate x:Key="FilterPanelAddPresetTemplate">
        <TextBlock Text="{DynamicResource LOCSaveLabel}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate x:Key="FilterPanelRenamePresetTemplate">
        <TextBlock Text="{DynamicResource LOCRenameTitle}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate x:Key="FilterPanelRemovePresetTemplate">
        <TextBlock Text="{DynamicResource LOCRemoveLabel}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <!-- Stopka paneli filtrów (NortniteFilterFooter) jest w Constants.xaml:
         CustomControls wczytują się przed tym plikiem, a StaticResource w szablonie
         widzi tylko zasoby z plików wczytanych wcześniej. -->

    <Style TargetType="{x:Type Filters}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Filters}">
                    <HeaderedContentControl Style="{StaticResource NortnitePanelStyle}" Tag="Overlay"
                                            Header="{DynamicResource LOCNortniteFiltersTitle}"
                                            Padding="21,27,18,15"
                                            TextElement.FontFamily="{Binding Path=Resources[NortniteFontHolder].Text, Source={x:Static Application.Current}, TargetNullValue=Consolas, FallbackValue=Consolas}"
                                            TextElement.FontSize="{DynamicResource NortniteFontSize}"
                                            TextElement.Foreground="{DynamicResource NortniteForegroundBrush}">
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Bottom" Focusable="False" Margin="0,12,6,0"
                                            ContentTemplate="{StaticResource NortniteFilterFooter}" />
                            <ItemsControlEx x:Name="PART_ItemsHost" Focusable="False"
                                            KeyboardNavigation.DirectionalNavigation="Once">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer Focusable="False"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="False">
                                            <ItemsPresenter Margin="3" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                            </ItemsControlEx>
                        </DockPanel>
                    </HeaderedContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
