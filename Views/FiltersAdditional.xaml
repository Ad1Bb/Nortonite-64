<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nortonite 64: filtry dodatkowe. Zajmuje miejsce lewego panelu, jak panel filtrów. -->
    <Style TargetType="{x:Type FiltersAdditional}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FiltersAdditional}">
                    <HeaderedContentControl Style="{StaticResource NortnitePanelStyle}" Tag="Overlay"
                                            Header="{DynamicResource LOCNortniteAdditionalFiltersTitle}"
                                            Padding="21,27,18,15"
                                            TextElement.FontFamily="{Binding Path=Resources[NortniteFontHolder].Text, Source={x:Static Application.Current}, TargetNullValue=Consolas, FallbackValue=Consolas}"
                                            TextElement.FontSize="{DynamicResource NortniteFontSize}"
                                            TextElement.Foreground="{DynamicResource NortniteForegroundBrush}">
                        <DockPanel x:Name="PART_MenuHost">
                            <!-- ◄ Filtry -->
                            <ButtonEx x:Name="PART_ButtonBack" DockPanel.Dock="Top" Margin="3,3,3,9"
                                      Style="{StaticResource NortniteRowButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◄ " />
                                    <TextBlock Text="{DynamicResource LOCFilters}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ButtonEx>
                            <Border DockPanel.Dock="Top" Height="3" Margin="0,0,0,9"
                                    Background="{DynamicResource NortniteBarBrush}" />
                            <ContentControl DockPanel.Dock="Bottom" Focusable="False" Margin="0,12,6,0"
                                            ContentTemplate="{StaticResource NortniteFilterFooter}" />
                            <ItemsControlEx x:Name="PART_ItemsHost" Margin="3,0,3,0"
                                            Focusable="False"
                                            KeyboardNavigation.DirectionalNavigation="Once" />
                        </DockPanel>
                    </HeaderedContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
