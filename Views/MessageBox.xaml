<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Nortonite 64 · okno komunikatu (makieta 08)
        Szerokość okna Playnite dopasowuje do treści (treść ma limit 900 px).
        Tytuł leży w kontenerze z marginesem 30 px, więc ujemny margines
        rozciąga turkusową belkę do krawędzi ramki.
        Przyciski stoją w panelu wyrównanym do lewej w kodzie Playnite.
    -->
    <Style x:Key="MessageBoxBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NortniteBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="TextElement.FontFamily" Value="{Binding Path=Resources[NortniteFontHolder].Text, Source={x:Static Application.Current}, TargetNullValue=Consolas, FallbackValue=Consolas}" />
        <Setter Property="TextElement.FontSize" Value="33" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource NortniteForegroundBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="MinWidth" Value="600" />
    </Style>

    <Style x:Key="MessageBoxCaptionText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource NortniteBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource NortniteBarBrush}" />
        <Setter Property="Padding" Value="24,12,24,12" />
        <Setter Property="Margin" Value="-30,-30,-30,30" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MessageBoxMessageText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize" Value="34.5" />
        <Setter Property="Foreground" Value="{DynamicResource NortniteBrightBrush}" />
        <Setter Property="LineHeight" Value="42" />
        <Setter Property="Margin" Value="6,0,6,6" />
    </Style>

    <Style x:Key="MessageBoxButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="6,6,24,0" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="MinHeight" Value="66" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="Padding" Value="27,3,27,3" />
    </Style>
</ResourceDictionary>
