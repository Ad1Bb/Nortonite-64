<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nortonite 64: symbole przycisków pada (Xbox) w palecie motywu: szare pole, biały znak.
         Wariant PlayStation Playnite zawsze wczytuje z motywu domyślnego. -->

    <DataTemplate x:Key="ButtonPromptA">
        <Viewbox>
            <ContentControl Tag="A" Height="39" Style="{StaticResource NortnitePadKey}" />
        </Viewbox>
    </DataTemplate>

